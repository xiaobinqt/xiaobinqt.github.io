16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-2\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eICP: \u003cspan class=\"s2\"\u003e\u0026#34;\u0026lt;a href=https://beian.miit.gov.cn/ target=_blank\u0026gt;京ICP备16062974号-1\u0026lt;/a\u0026gt;\u0026#34;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/296318e8d2664cc3bb920f1c9406ed4a_6049638848002945655.png\" title=\"simple-template-renderer\" data-thumbnail=\"/296318e8d2664cc3bb920f1c9406ed4a_6049638848002945655.png\" data-sub-html=\"\u003ch2\u003esimple-template-renderer\u003c/h2\u003e\u003cp\u003esimple-template-renderer\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/296318e8d2664cc3bb920f1c9406ed4a_6049638848002945655.png srcset=\"/296318e8d2664cc3bb920f1c9406ed4a_6049638848002945655_hu7882293949740624168.webp 800w, /296318e8d2664cc3bb920f1c9406ed4a_6049638848002945655_hu11608315991442156706.webp 1200w, /296318e8d2664cc3bb920f1c9406ed4a_6049638848002945655_hu13382010030635763259.webp 1600w\"  alt=\"simple-template-renderer\" height=\"238\" width=\"1197\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003esimple-template-renderer\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "Gitalk 初始化 issue",
        "date_published" : "2022-04-01T00:00:00Z",
        "date_modified" : "2022-11-02T21:58:16+08:00",
        "id" : "https://www.xiaobinqt.cn/gitalk-init-issue/",
        "url" : "https://www.xiaobinqt.cn/gitalk-init-issue/",
        "summary": "在用 Gitalk 作为个人博客评论系统时，发现有个恶心的点是，每篇文章必须手动初始化一个 issue 或是登录 github 后，把文章一个一个点开界面去初始化 issue，不然就会出现以下的提示\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003cp\u003e在用 Gitalk 作为个人博客评论系统时，发现有个恶心的点是，每篇文章必须手动初始化一个 issue 或是登录 github 后，把文章一个一个点开界面去初始化 issue，不然就会出现以下的提示\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e360635c7d7b4e5b931306af6c0455cd_16661225433186004331.png\" title=\"no issus\" data-thumbnail=\"/e360635c7d7b4e5b931306af6c0455cd_16661225433186004331.png\" data-sub-html=\"\u003ch2\u003eno issus\u003c/h2\u003e\u003cp\u003eno issus\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e360635c7d7b4e5b931306af6c0455cd_16661225433186004331.png srcset=\"/e360635c7d7b4e5b931306af6c0455cd_16661225433186004331_hu13310643599108957585.webp 800w, /e360635c7d7b4e5b931306af6c0455cd_16661225433186004331_hu15479564126325451074.webp 1200w, /e360635c7d7b4e5b931306af6c0455cd_16661225433186004331_hu16062572943636060850.webp 1600w\"  alt=\"no issus\" height=\"220\" width=\"457\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eno issus\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e个人觉得这件事情非常麻烦，\u003cstrong\u003eGitalk 使用 labels 来映射 issuse\u003c/strong\u003e，可以看下我用的主题 Gitalk 在初始化评论时发出的网络请求\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/be1fd41847d1449c8287f4a7820a35e1_6986588518222880987.png\" title=\"创建 issue 的请求\" data-thumbnail=\"/be1fd41847d1449c8287f4a7820a35e1_6986588518222880987.png\" data-sub-html=\"\u003ch2\u003e创建 issue 的请求\u003c/h2\u003e\u003cp\u003e创建 issue 的请求\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/be1fd41847d1449c8287f4a7820a35e1_6986588518222880987.png srcset=\"/be1fd41847d1449c8287f4a7820a35e1_6986588518222880987_hu6618575251011138018.webp 800w, /be1fd41847d1449c8287f4a7820a35e1_6986588518222880987_hu3069100350023194175.webp 1200w, /be1fd41847d1449c8287f4a7820a35e1_6986588518222880987_hu15787579222823671452.webp 1600w\"  alt=\"创建 issue 的请求\" height=\"209\" width=\"855\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e创建 issue 的请求\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003elabels 第一个参数是 Gitalk，第二个参数是文章的发布时间，呃，感觉改成文章的 path 会更好，但是 \u003cstrong\u003egithub label 的最大长度是 50 个字符\u003c/strong\u003e，所以把 path md5 会更好。我看了下源码修改成了 URL\npath 的 md5 格式\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003ethemes/LoveIt/layouts/partials/comment.html\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/94a28c0aa1fd4f44a034b1dce2087af4_11859489285827776095.png\" title=\"comment id\" data-thumbnail=\"/94a28c0aa1fd4f44a034b1dce2087af4_11859489285827776095.png\" data-sub-html=\"\u003ch2\u003ecomment id\u003c/h2\u003e\u003cp\u003ecomment id\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/94a28c0aa1fd4f44a034b1dce2087af4_11859489285827776095.png srcset=\"/94a28c0aa1fd4f44a034b1dce2087af4_11859489285827776095_hu12431657107777523667.webp 800w, /94a28c0aa1fd4f44a034b1dce2087af4_11859489285827776095_hu15339538979421925857.webp 1200w, /94a28c0aa1fd4f44a034b1dce2087af4_11859489285827776095_hu7972130502328853165.webp 1600w\"  alt=\"comment id\" height=\"118\" width=\"1846\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003ecomment id\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e初始工作做完，就可以写脚本了。\u003c/p\u003e\n\u003ch2 id=\"分析\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%88%86%e6%9e%90\" class=\"header-mark\"\u003e\u003c/a\u003e1 分析\u003c/h2\u003e\u003cp\u003e我们要做的事其实就是给每篇新文章初始化一个 issue，可以用 github Actions 来做这件事。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/fcdfd734b67b4e4283637061f717788b_8819934995089867834.png\" title=\"初始化 issue 大致逻辑\" data-thumbnail=\"/fcdfd734b67b4e4283637061f717788b_8819934995089867834.png\" data-sub-html=\"\u003ch2\u003e初始化 issue 大致逻辑\u003c/h2\u003e\u003cp\u003e初始化 issue 大致逻辑\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/fcdfd734b67b4e4283637061f717788b_8819934995089867834.png srcset=\"/fcdfd734b67b4e4283637061f717788b_8819934995089867834_hu16991673691883929341.webp 800w, /fcdfd734b67b4e4283637061f717788b_8819934995089867834_hu1730699968801780684.webp 1200w, /fcdfd734b67b4e4283637061f717788b_8819934995089867834_hu3200904982666687126.webp 1600w\"  alt=\"初始化 issue 大致逻辑\" height=\"472\" width=\"506\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e初始化 issue 大致逻辑\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e这里有几个稍微麻烦的地方，以下是我的实现方案，\u003cstrong\u003e仅仅是提供一个思路\u003c/strong\u003e。\u003c/p\u003e\n\u003ch3 id=\"获取所有文章信息\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e8%8e%b7%e5%8f%96%e6%89%80%e6%9c%89%e6%96%87%e7%ab%a0%e4%bf%a1%e6%81%af\" class=\"header-mark\"\u003e\u003c/a\u003e1.1 获取所有文章信息\u003c/h3\u003e\u003cp\u003e怎么获取所有的文章\u0026#x2753;，我用的 \u003ca href=\"https://github.com/dillonzq/LoveIt\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eLoveIt\u003c/a\u003e 主题在 build 时在 public 目录里会有一个 index.json\n文件，里面包含了所有的文章的信息。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e224ac9d408e4dea972caecabecec8ba_14460049229835189975.png\" title=\"public index.json\" data-thumbnail=\"/e224ac9d408e4dea972caecabecec8ba_14460049229835189975.png\" data-sub-html=\"\u003ch2\u003epublic index.json\u003c/h2\u003e\u003cp\u003epublic index.json\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e224ac9d408e4dea972caecabecec8ba_14460049229835189975.png srcset=\"/e224ac9d408e4dea972caecabecec8ba_14460049229835189975_hu7302307372830280784.webp 800w, /e224ac9d408e4dea972caecabecec8ba_14460049229835189975_hu703023147778002676.webp 1200w, /e224ac9d408e4dea972caecabecec8ba_14460049229835189975_hu16165917311120392602.webp 1600w\"  alt=\"public index.json\" height=\"446\" width=\"1095\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003epublic index.json\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e其他的主题可以使用 sitemap.xml 来获取所有的文章信息，hugo 在 build 时会生成 sitemap.xml 文件。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/f59bb44ee8924b639a949bb494a40b9c_14775157900184725937.png\" title=\"sitemap.xml\" data-thumbnail=\"/f59bb44ee8924b639a949bb494a40b9c_14775157900184725937.png\" data-sub-html=\"\u003ch2\u003esitemap.xml\u003c/h2\u003e\u003cp\u003esitemap.xml\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/f59bb44ee8924b639a949bb494a40b9c_14775157900184725937.png srcset=\"/f59bb44ee8924b639a949bb494a40b9c_14775157900184725937_hu15671620584060569698.webp 800w, /f59bb44ee8924b639a949bb494a40b9c_14775157900184725937_hu8452383918920032467.webp 1200w, /f59bb44ee8924b639a949bb494a40b9c_14775157900184725937_hu11931822289021335619.webp 1600w\"  alt=\"sitemap.xml\" height=\"198\" width=\"401\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003esitemap.xml\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"issue-如何初始化\" class=\"headerLink\"\u003e\n    \u003ca href=\"#issue-%e5%a6%82%e4%bd%95%e5%88%9d%e5%a7%8b%e5%8c%96\" class=\"header-mark\"\u003e\u003c/a\u003e1.2 issue 如何初始化\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/3f28b1b6486e44cfbeeef571bfded6f2_14386163217487813401.png\" title=\"issue内容\" data-thumbnail=\"/3f28b1b6486e44cfbeeef571bfded6f2_14386163217487813401.png\" data-sub-html=\"\u003ch2\u003eissue内容\u003c/h2\u003e\u003cp\u003eissue内容\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/3f28b1b6486e44cfbeeef571bfded6f2_14386163217487813401.png srcset=\"/3f28b1b6486e44cfbeeef571bfded6f2_14386163217487813401_hu12706399629784677454.webp 800w, /3f28b1b6486e44cfbeeef571bfded6f2_14386163217487813401_hu12288580843665391866.webp 1200w, /3f28b1b6486e44cfbeeef571bfded6f2_14386163217487813401_hu610142073858653918.webp 1600w\"  alt=\"issue内容\" height=\"324\" width=\"1315\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eissue内容\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e如上截图\u0026#x1f446;是我创建的 issue 内容。body 是文章的 URL，title 是文章标题，labels 有 Gitalk 和文章的 URL path 的 md5\n两个。那么问题就简单了，我们只需要给每篇文章初始化一个这样的 issue 就可以了。\u003c/p\u003e\n\u003cp\u003e固定文章的 URL 为唯一标识，组成两个 map ，map 键就是文章的 URL。一个 map 是 github 已存在的 issue 暂定为 \u003ccode\u003eissue_map\u003c/code\u003e，一个 map 是我们所有文章的 map 暂定为 \u003ccode\u003eposts_map\u003c/code\u003e\n，URL 在 \u003ccode\u003eposts_map\u003c/code\u003e\n中存在但是 \u003ccode\u003eissue_map\u003c/code\u003e 不存在的就是\u003cstrong\u003e新增\u003c/strong\u003e\n。URL 在 \u003ccode\u003eposts_map\u003c/code\u003e 和 \u003ccode\u003eissue_map\u003c/code\u003e 中都存在但是 \u003ccode\u003eposts_map\u003c/code\u003e 中的标题跟 \u003ccode\u003eissue_map\u003c/code\u003e 中的标题不相同可能就是文章标题被修改了。\u003c/p\u003e\n\u003cp\u003e对于新的 URL 我的做法是承认它是新文章，或是旧文章的 URL 被修改了那只能去 github 手动修改 issue body 为新的 URL, label 为新的 uri 的 md5 值。\u003c/p\u003e\n\u003ch2 id=\"python-脚本实现\" class=\"headerLink\"\u003e\n    \u003ca href=\"#python-%e8%84%9a%e6%9c%ac%e5%ae%9e%e7%8e%b0\" class=\"header-mark\"\u003e\u003c/a\u003e2 python 脚本实现\u003c/h2\u003e\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003epython\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.73c10.33 0 15.94 2.44 15.94 9.09 0 4.72-4.2 8.22-14.36 8.22a41.54 41.54 0 0 1-15.47-3.12c-6.49-3.88-11.74-3.5-15.6 3.12l-5.59 9.31c-3.72 6.13-3.19 11.72 2.63 15.94 7.71 4.69 20.38 9.44 37 9.44 34.16 0 48.5-22.75 48.5-44.12-.03-14.38-9.12-29.76-28.73-34.88zM496 224H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zm0-160H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16V80a16 16 0 0 0-16-16zm0 320H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zM16 160h64a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H64V40a8 8 0 0 0-8-8H32a8 8 0 0 0-7.14 4.42l-8 16A8 8 0 0 0 24 64h8v64H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8zm-3.91 160H80a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H41.32c3.29-10.29 48.34-18.68 48.34-56.44 0-29.06-25-39.56-44.47-39.56-21.36 0-33.8 10-40.46 18.75-4.37 5.59-3 10.84 2.8 15.37l8.58 6.88c5.61 4.56 11 2.47 16.12-2.44a13.44 13.44 0 0 1 9.46-3.84c3.33 0 9.28 1.56 9.28 8.75C51 248.19 0 257.31 0 304.59v4C0 316 5.08 320 12.09 320z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n      \u003cbutton \n        class=\"\n          wrap-code-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.is-wrap]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle code wrap\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51