18.75-4.37 5.59-3 10.84 2.8 15.37l8.58 6.88c5.61 4.56 11 2.47 16.12-2.44a13.44 13.44 0 0 1 9.46-3.84c3.33 0 9.28 1.56 9.28 8.75C51 248.19 0 257.31 0 304.59v4C0 316 5.08 320 12.09 320z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n      \u003cbutton \n        class=\"\n          wrap-code-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.is-wrap]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle code wrap\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-13\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"cp\"\u003e#!/bin/bash\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"cp\"\u003e\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003elet\u003c/span\u003e \u003cspan class=\"nv\"\u003ea\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003e\u003cspan class=\"m\"\u003e0\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"k\"\u003efor\u003c/span\u003e i in \u003cspan class=\"k\"\u003e$(\u003c/span\u003eseq \u003cspan class=\"m\"\u003e1\u003c/span\u003e 10\u003cspan class=\"k\"\u003e)\u003c/span\u003e\u003cspan class=\"p\"\u003e;\u003c/span\u003e\u003cspan class=\"k\"\u003edo\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  array\u003cspan class=\"o\"\u003e[\u003c/span\u003ea\u003cspan class=\"o\"\u003e]=\u003c/span\u003e\u003cspan class=\"nv\"\u003e$i\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e  \u003cspan class=\"nb\"\u003elet\u003c/span\u003e a++\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"k\"\u003edone\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eecho\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;一个添加多个元素：e f g\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nv\"\u003earray\u003c/span\u003e\u003cspan class=\"o\"\u003e+=(\u003c/span\u003ee f g\u003cspan class=\"o\"\u003e)\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eecho\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;数组所有元素 \u003c/span\u003e\u003cspan class=\"si\"\u003e${\u003c/span\u003e\u003cspan class=\"nv\"\u003earray\u003c/span\u003e\u003cspan class=\"p\"\u003e[*]\u003c/span\u003e\u003cspan class=\"si\"\u003e}\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"c1\"\u003e# shellcheck disable=SC2145\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eecho\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;数组所有下标: \u003c/span\u003e\u003cspan class=\"si\"\u003e${\u003c/span\u003e\u003cspan class=\"p\"\u003e!array[@]\u003c/span\u003e\u003cspan class=\"si\"\u003e}\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eecho\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;数组长度为：\u003c/span\u003e\u003cspan class=\"si\"\u003e${#\u003c/span\u003e\u003cspan class=\"nv\"\u003earray\u003c/span\u003e\u003cspan class=\"p\"\u003e[*]\u003c/span\u003e\u003cspan class=\"si\"\u003e}\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eecho\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;数组第一个元素为：\u003c/span\u003e\u003cspan class=\"si\"\u003e${\u003c/span\u003e\u003cspan class=\"nv\"\u003earray\u003c/span\u003e\u003cspan class=\"p\"\u003e[0]\u003c/span\u003e\u003cspan class=\"si\"\u003e}\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eecho\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;删除数组第二个元素\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"c1\"\u003e# shellcheck disable=SC2184\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eunset\u003c/span\u003e array\u003cspan class=\"o\"\u003e[\u003c/span\u003e1\u003cspan class=\"o\"\u003e]\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nb\"\u003eecho\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;再次数组所有元素 \u003c/span\u003e\u003cspan class=\"si\"\u003e${\u003c/span\u003e\u003cspan class=\"nv\"\u003earray\u003c/span\u003e\u003cspan class=\"p\"\u003e[*]\u003c/span\u003e\u003cspan class=\"si\"\u003e}\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/45e1e48fc0ce4d1ca29cb4593a79257b_15570653303602599961.png\" title=\"数组操作\" data-thumbnail=\"/45e1e48fc0ce4d1ca29cb4593a79257b_15570653303602599961.png\" data-sub-html=\"\u003ch2\u003e数组操作\u003c/h2\u003e\u003cp\u003e数组操作\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/45e1e48fc0ce4d1ca29cb4593a79257b_15570653303602599961.png srcset=\"/45e1e48fc0ce4d1ca29cb4593a79257b_15570653303602599961_hu12704424982049897703.webp 800w, /45e1e48fc0ce4d1ca29cb4593a79257b_15570653303602599961_hu16041703095167817088.webp 1200w, /45e1e48fc0ce4d1ca29cb4593a79257b_15570653303602599961_hu3846323656328096782.webp 1600w\"  alt=\"数组操作\" height=\"214\" width=\"539\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e数组操作\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"cloc\" class=\"headerLink\"\u003e\n    \u003ca href=\"#cloc\" class=\"header-mark\"\u003e\u003c/a\u003e7 cloc\u003c/h2\u003e\u003cp\u003e[cloc]^(count lines of code)，是一款使用 Perl 语言开发的开源代码统计工具，支持多平台使用、多语言识别。从名字就能够直观地知道它的功能：可以帮助计算文件中的有效代码数量，而且会自动排除注释和空格。\u003c/p\u003e\n\u003cp\u003ecloc git 地址 \u003ca href=\"https://github.com/AlDanial/cloc\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://github.com/AlDanial/cloc\u003c/a\u003e，官网地址 \u003ca href=\"https://cloc.sourceforge.net/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://cloc.sourceforge.net/\u003c/a\u003e。\u003c/p\u003e\n\u003cp\u003ecloc 还可以通过 \u003ca href=\"https://www.npmjs.com/package/cloc\" target=\"_blank\" rel=\"noopener noreferrer\"\u003enpm 安装\u003c/a\u003e。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/148b71653e5b473a82e398a23d5ad399_7457290658769721933.png\" title=\"cloc\" data-thumbnail=\"/148b71653e5b473a82e398a23d5ad399_7457290658769721933.png\" data-sub-html=\"\u003ch2\u003ecloc\u003c/h2\u003e\u003cp\u003ecloc\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/148b71653e5b473a82e398a23d5ad399_7457290658769721933.png srcset=\"/148b71653e5b473a82e398a23d5ad399_7457290658769721933_hu13862819028938663383.webp 800w, /148b71653e5b473a82e398a23d5ad399_7457290658769721933_hu18370793828097344570.webp 1200w, /148b71653e5b473a82e398a23d5ad399_7457290658769721933_hu13559179920179143961.webp 1600w\"  alt=\"cloc\" height=\"559\" width=\"756\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003ecloc\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e在执行完\u003ccode\u003ecloc\u003c/code\u003e命令以后它会计算不一样编程语言的文件数（files）、空行（blank）、注释（comment）和代码行数（code），而且最后返回 SUM 总数。\u003c/p\u003e\n\u003ch3 id=\"常用命令-1\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%b8%b8%e7%94%a8%e5%91%bd%e4%bb%a4-1\" class=\"header-mark\"\u003e\u003c/a\u003e7.1 常用命令\u003c/h3\u003e\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: left\"\u003e命令\u003c/th\u003e\n            \u003cth style=\"text-align: left\"\u003e说明\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e--ignore-whitespace\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e在使用\u0026ndash;diff比较文件时忽略水平空格\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e--max-file-size=\u0026lt;MB\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e若是要跳过大于给定大小MB的文件\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e--exclude-dir=\u0026lt;dir1\u0026gt;,\u0026lt;dir2\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e排除给定的逗号分隔目录\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e--exclude-ext=\u0026lt;ext1\u0026gt;,\u0026lt;ext2\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e排除给定的文件扩展名\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e--out=\u0026lt;file\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e将结果保存到\u003ccode\u003e\u0026lt;file\u0026gt;\u003c/code\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e--quiet\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e禁止全部信息消息并仅显示最终报告\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e--diff\u0026lt;set1\u0026gt; \u0026lt;set2\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e计算set1和set2的源文件之间的代码差别。 输入能够是文件和目录的混合\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003ch2 id=\"参考\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%8f%82%e8%80%83\" class=\"header-mark\"\u003e\u003c/a\u003e8 参考\u003c/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://blog.csdn.net/workdsz/article/details/78489101\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ecurl -w,–write-out参数详解\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://blog.csdn.net/jiangjun_dao519/article/details/125593433\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e【linux】查看文件目录大小\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "IPv4 forwarding is disabled. Networking will not work",
        "date_published" : "2020-11-08T00:00:00Z",
        "date_modified" : "2022-11-01T21:46:00+08:00",
        "id" : "https://www.xiaobinqt.cn/ipv4-forwarding-is-disabled-networking-will-not-work/",
        "url" : "https://www.xiaobinqt.cn/ipv4-forwarding-is-disabled-networking-will-not-work/",
        "summary": " 1 问题今天在操作 docker 时遇到了一个问题IPv4 forwarding is disabled. Networking will not work\u0026#x1f447;\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003c!-- author： xiaobinqt --\u003e\n\u003c!-- email： xiaobinqt@163.com --\u003e\n\u003c!-- https://xiaobinqt.github.io --\u003e\n\u003c!-- https://www.xiaobinqt.cn --\u003e\n\u003ch2 id=\"问题\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e9%97%ae%e9%a2%98\" class=\"header-mark\"\u003e\u003c/a\u003e1 问题\u003c/h2\u003e\u003cp\u003e今天在操作 docker 时遇到了一个问题\u003ccode\u003eIPv4 forwarding is disabled. Networking will not work\u003c/code\u003e\u0026#x1f447;\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e1bf06fd0d134476833680c7c412da4a_8000363411573178690.png\" title=\"报错信息\" data-thumbnail=\"/e1bf06fd0d134476833680c7c412da4a_8000363411573178690.png\" data-sub-html=\"\u003ch2\u003e报错信息\u003c/h2\u003e\u003cp\u003e报错信息\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e1bf06fd0d134476833680c7c412da4a_8000363411573178690.png srcset=\"/e1bf06fd0d134476833680c7c412da4a_8000363411573178690_hu17394518256766709480.webp 800w, /e1bf06fd0d134476833680c7c412da4a_8000363411573178690_hu14326313434521394885.webp 1200w, /e1bf06fd0d134476833680c7c412da4a_8000363411573178690_hu2639465591810302725.webp 1600w\"  alt=\"报错信息\" height=\"136\" width=\"915\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e报错信息\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e我的系统是 CentOS7.9\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/bd163e7f159544fb82224f0e6e37fbf6_2665209206033326249.png\" title=\"系统信息\" data-thumbnail=\"/bd163e7f159544fb82224f0e6e37fbf6_2665209206033326249.png\" data-sub-html=\"\u003ch2\u003e系统信息\u003c/h2\u003e\u003cp\u003e系统信息\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/bd163e7f159544fb82224f0e6e37fbf6_2665209206033326249.png srcset=\"/bd163e7f159544fb82224f0e6e37fbf6_2665209206033326249_hu14512485641761627618.webp 800w, /bd163e7f159544fb82224f0e6e37fbf6_2665209206033326249_hu14806973806068802278.webp 1200w, /bd163e7f159544fb82224f0e6e37fbf6_2665209206033326249_hu17308621111083477416.webp 1600w\"  alt=\"系统信息\" height=\"218\" width=\"1078\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e系统信息\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"解决方案\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e8%a7%a3%e5%86%b3%e6%96%b9%e6%a1%88\" class=\"header-mark\"\u003e\u003c/a\u003e2 解决方案\u003c/h2\u003e\u003cp\u003e在宿主机执行\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003eshell\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block 