512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-3\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003edocker swarm join --token SWMTKN-1-15692f3ho3t3oi68ljnv0fi5nxerox2jsuplmhv0qzerzqpfh1-er9ufvvh4bym5o3iifummtvnf 192.168.48.125:2377\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/04a42d532f814048aa2b5036d7165e5a_14114202214274124597.png\" title=\"加入集群\" data-thumbnail=\"/04a42d532f814048aa2b5036d7165e5a_14114202214274124597.png\" data-sub-html=\"\u003ch2\u003e加入集群\u003c/h2\u003e\u003cp\u003e加入集群\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/04a42d532f814048aa2b5036d7165e5a_14114202214274124597.png srcset=\"/04a42d532f814048aa2b5036d7165e5a_14114202214274124597_hu12937912645275494379.webp 800w, /04a42d532f814048aa2b5036d7165e5a_14114202214274124597_hu12447015773861512246.webp 1200w, /04a42d532f814048aa2b5036d7165e5a_14114202214274124597_hu4602087371240845354.webp 1600w\"  alt=\"加入集群\" height=\"105\" width=\"1532\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e加入集群\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e此时在管理节点可以看到刚加进来的\u003ccode\u003e192.168.48.8\u003c/code\u003e工作节点：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/f883196e32e04000a22eebf0297910a9_4083801786057713947.png\" title=\"工作节点加入成功\" data-thumbnail=\"/f883196e32e04000a22eebf0297910a9_4083801786057713947.png\" data-sub-html=\"\u003ch2\u003e工作节点加入成功\u003c/h2\u003e\u003cp\u003e工作节点加入成功\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/f883196e32e04000a22eebf0297910a9_4083801786057713947.png srcset=\"/f883196e32e04000a22eebf0297910a9_4083801786057713947_hu17001410904763034685.webp 800w, /f883196e32e04000a22eebf0297910a9_4083801786057713947_hu13669771021082001590.webp 1200w, /f883196e32e04000a22eebf0297910a9_4083801786057713947_hu7819004055577053031.webp 1600w\"  alt=\"工作节点加入成功\" height=\"149\" width=\"1039\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e工作节点加入成功\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"使用集群服务\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%bd%bf%e7%94%a8%e9%9b%86%e7%be%a4%e6%9c%8d%e5%8a%a1\" class=\"header-mark\"\u003e\u003c/a\u003e2.3 使用集群服务\u003c/h3\u003e\u003cp\u003e搭建成功的集群，可以使用使用\u003ccode\u003edocker service\u003c/code\u003e命令使用 Swarm 提供的服务。\u003c/p\u003e\n\u003cp\u003e可以在管理节点上执行如下命令来快速创建一个应用服务，并制定服务的复制份数为 2。如下命令所示，默认会自动检查确认服务状态都正常：\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-