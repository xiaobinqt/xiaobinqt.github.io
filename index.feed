s=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"k\"\u003eselect\u003c/span\u003e\u003cspan class=\"w\"\u003e \u003c/span\u003e\u003cspan class=\"nf\"\u003eFROM_UNIXTIME\u003c/span\u003e\u003cspan class=\"p\"\u003e(\u003c/span\u003e\u003cspan class=\"mi\"\u003e1156219870\u003c/span\u003e\u003cspan class=\"p\"\u003e);\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/16f68bfe754148f1bd995b6aa0b2e74c_13351495609126380811.png\" title=\"FROM_UNIXTIME\" data-thumbnail=\"/16f68bfe754148f1bd995b6aa0b2e74c_13351495609126380811.png\" data-sub-html=\"\u003ch2\u003eFROM_UNIXTIME\u003c/h2\u003e\u003cp\u003eFROM_UNIXTIME\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/16f68bfe754148f1bd995b6aa0b2e74c_13351495609126380811.png srcset=\"/16f68bfe754148f1bd995b6aa0b2e74c_13351495609126380811_hu14064631159792054262.webp 800w, /16f68bfe754148f1bd995b6aa0b2e74c_13351495609126380811_hu13607326620241921248.webp 1200w, /16f68bfe754148f1bd995b6aa0b2e74c_13351495609126380811_hu14561190355637880136.webp 1600w\"  alt=\"FROM_UNIXTIME\" height=\"206\" width=\"430\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eFROM_UNIXTIME\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e日期转换为UNIX时间戳用函数： \u003ccode\u003eUNIX_TIMESTAMP()\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/d1182fbf011d43bf95af2b195956f88b_8751141153757182333.png\" title=\"UNIX_TIMESTAMP\" data-thumbnail=\"/d1182fbf011d43bf95af2b195956f88b_8751141153757182333.png\" data-sub-html=\"\u003ch2\u003eUNIX_TIMESTAMP\u003c/h2\u003e\u003cp\u003eUNIX_TIMESTAMP\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/d1182fbf011d43bf95af2b195956f88b_8751141153757182333.png srcset=\"/d1182fbf011d43bf95af2b195956f88b_8751141153757182333_hu2677627209636777446.webp 800w, /d1182fbf011d43bf95af2b195956f88b_8751141153757182333_hu319651373986590448.webp 1200w, /d1182fbf011d43bf95af2b195956f88b_8751141153757182333_hu7864228705099353884.webp 1600w\"  alt=\"UNIX_TIMESTAMP\" height=\"339\" width=\"565\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eUNIX_TIMESTAMP\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "windows 重做系统",
        "date_published" : "2018-10-07T00:00:00Z",
        "date_modified" : "2023-03-20T14:25:32+08:00",
        "id" : "https://www.xiaobinqt.cn/redo-system/",
        "url" : "https://www.xiaobinqt.cn/redo-system/",
        "summary": " 1 下载系统首先我们需要一个最小 4G 大的 U 盘\n进入大白菜网站下载大白菜装机版安装到电脑，好吧，之前一直叫大白菜，不知道什么时候改成叫老白菜了\u0026#x1f622;。\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003ch2 id=\"下载系统\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%b8%8b%e8%bd%bd%e7%b3%bb%e7%bb%9f\" class=\"header-mark\"\u003e\u003c/a\u003e1 下载系统\u003c/h2\u003e\u003cp\u003e首先我们需要一个最小 4G 大的 U 盘\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007201814_16577686316487173240.jpg\" title=\"image\" data-thumbnail=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007201814_16577686316487173240.jpg\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007201814_16577686316487173240.jpg srcset=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007201814_16577686316487173240_hu6150536040026175383.webp 800w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007201814_16577686316487173240_hu7161384985411635749.webp 1200w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007201814_16577686316487173240_hu11299448666758384586.webp 1600w\"  alt=\"image\" height=\"1443\" width=\"1080\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e进入\u003ca href=\"http://www.bigbaicai.com/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e大白菜网站\u003c/a\u003e下载大白菜装机版安装到电脑，好吧，之前一直叫大白菜，不知道什么时候改成叫老白菜了\u0026#x1f622;。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007195445_6519271344486192031.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007195445_6519271344486192031.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007195445_6519271344486192031.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007195445_6519271344486192031_hu13762325680777771697.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007195445_6519271344486192031_hu16315872875766413016.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007195445_6519271344486192031_hu4662625971535695080.webp 1600w\"  alt=\"image\" height=\"605\" width=\"939\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007195654_12250078605310445953.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007195654_12250078605310445953.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007195654_12250078605310445953.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007195654_12250078605310445953_hu13085109438722019522.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007195654_12250078605310445953_hu14005551241327650192.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007195654_12250078605310445953_hu8072650573725700399.webp 1600w\"  alt=\"image\" height=\"169\" width=\"180\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e将 U 盘插到电脑上,双击打开大白菜装机版,它会自动读到我们插入的 U 盘，自动匹配默认模式,不需要手动选择。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007203320_15668476560109004940.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007203320_15668476560109004940.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007203320_15668476560109004940.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007203320_15668476560109004940_hu3123388264954932999.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007203320_15668476560109004940_hu6194952276986302810.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007203320_15668476560109004940_hu3317591362296380356.webp 1600w\"  alt=\"image\" height=\"591\" width=\"804\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e点击开始制作 \u0026ndash;\u0026gt; 确认\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007203544_13003315155394047564.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007203544_13003315155394047564.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007203544_13003315155394047564.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007203544_13003315155394047564_hu11077372224557669856.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007203544_13003315155394047564_hu15593513784194835584.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007203544_13003315155394047564_hu7037478151769330304.webp 1600w\"  alt=\"image\" height=\"560\" width=\"813\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e等待写入数据包完成和格式化完成后关掉大白菜软件\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007203843_3047021506821678634.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007203843_3047021506821678634.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007203843_3047021506821678634.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007203843_3047021506821678634_hu2804107559265291601.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007203843_3047021506821678634_hu2868323373769240692.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007203843_3047021506821678634_hu6433567786249250417.webp 1600w\"  alt=\"image\" height=\"531\" width=\"781\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007204132_15992159019511061685.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007204132_15992159019511061685.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007204132_15992159019511061685.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007204132_15992159019511061685_hu10133505935321127779.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007204132_15992159019511061685_hu813948308888491796.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007204132_15992159019511061685_hu16278247018295910896.webp 1600w\"  alt=\"image\" height=\"533\" width=\"781\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007204222_9847443056437821563.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007204222_9847443056437821563.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007204222_9847443056437821563.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007204222_9847443056437821563_hu10728579265556823863.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007204222_9847443056437821563_hu15502472872927728936.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007204222_9847443056437821563_hu1861710029448414154.webp 1600w\"  alt=\"image\" height=\"640\" width=\"1302\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e制作完 U 盘启动盘后我们的 U 盘会变成这样说明启动盘已经制作成功 !\u003c/p\u003e\n\u003cp\u003e\u003ca href=\"https://cdn.xiaobinqt.cn/TIM%E6%88%AA%E5%9B%BE20181007204825.png\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eimage\u003c/a\u003e\u003cimg class=\"tw-inline\" loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007204842_9824358454680149915.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007204842_9824358454680149915_hu8967563942909649630.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007204842_9824358454680149915_hu10268503371392597800.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007204842_9824358454680149915_hu7603782715894340781.webp 1600w\"  alt=\"image\" height=\"182\" width=\"868\"\u003e\u003c/p\u003e\n\u003cp\u003e去\u003ca href=\"https://msdn.itellyou.cn/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eitellyou\u003c/a\u003e下载需要安装的操作系统 !\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007205139_1261459727416619769.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007205139_1261459727416619769.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007205139_1261459727416619769.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007205139_1261459727416619769_hu287443837946457418.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007205139_1261459727416619769_hu12544607176969545615.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007205139_1261459727416619769_hu11257489091866749418.webp 1600w\"  alt=\"image\" height=\"919\" width=\"775\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e比如我们要安装这个版本的 win10\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007205619_6592367839099647702.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007205619_6592367839099647702.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007205619_6592367839099647702.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007205619_6592367839099647702_hu13170629520144362169.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007205619_6592367839099647702_hu10455246407022143679.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007205619_6592367839099647702_hu8571660274433936970.webp 1600w\"  alt=\"image\" height=\"690\" width=\"1248\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e通过百度网盘下载 ed2k 文件资源,然后再通过百度网盘下载到电脑本地,可以放在除 C 盘外的其他盘中\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE2018100720594sd0_7980439510345474412.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE2018100720594sd0_7980439510345474412.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE2018100720594sd0_7980439510345474412.png srcset=\"/TIM%E6%88%AA%E5%9B%BE2018100720594sd0_7980439510345474412_hu8995057039248284902.webp 800w, /TIM%E6%88%AA%E5%9B%BE2018100720594sd0_7980439510345474412_hu12252516051795326853.webp 1200w, /TIM%E6%88%AA%E5%9B%BE2018100720594sd0_7980439510345474412_hu15237743138466411440.webp 1600w\"  alt=\"image\" height=\"478\" width=\"864\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e下载到本地的文件是这样的光盘映像文件 !\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007211023_16275264130116938244.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007211023_16275264130116938244.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007211023_16275264130116938244.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007211023_16275264130116938244_hu6776244787307618483.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007211023_16275264130116938244_hu7340663036198109439.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007211023_16275264130116938244_hu931234766019819223.webp 1600w\"  alt=\"image\" height=\"257\" width=\"1034\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e将我们下载到电脑本地的光盘映像文件复制到刚制作完成的 U 盘启动盘中,复制完成后我们 U 盘启动盘就全部制作完成了\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007211227_5892489635912415070.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007211227_5892489635912415070.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007211227_5892489635912415070.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007211227_5892489635912415070_hu4404684542983942812.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007211227_5892489635912415070_hu15385132646150237569.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007211227_5892489635912415070_hu10528518315397532788.webp 1600w\"  alt=\"image\" height=\"461\" width=\"937\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"重做系统\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e9%87%8d%e5%81%9a%e7%b3%bb%e7%bb%9f\" class=\"header-mark\"\u003e\u003c/a\u003e2 重做系统\u003c/h2\u003e\u003cp\u003e将我们制作好的 U 盘启动盘插到需要重做系统的电脑上,重启电脑一直按 F12 进入 bios 界面(不同的电脑可能按键不同,可以百度)\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214346_15902937957169451157.jpg\" title=\"image\" data-thumbnail=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214346_15902937957169451157.jpg\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214346_15902937957169451157.jpg srcset=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214346_15902937957169451157_hu5920015316566885301.webp 800w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214346_15902937957169451157_hu10875734845341863513.webp 1200w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214346_15902937957169451157_hu4285715610170962036.webp 1600w\"  alt=\"image\" height=\"1080\" width=\"1443\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e选择 usb 方式,回车进入大白菜启动方式,选择 02 方式进入\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/TIM%E6%88%AA%E5%9B%BE20181007214548_1049459270869982429.png\" title=\"image\" data-thumbnail=\"/TIM%E6%88%AA%E5%9B%BE20181007214548_1049459270869982429.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/TIM%E6%88%AA%E5%9B%BE20181007214548_1049459270869982429.png srcset=\"/TIM%E6%88%AA%E5%9B%BE20181007214548_1049459270869982429_hu13671686360644543844.webp 800w, /TIM%E6%88%AA%E5%9B%BE20181007214548_1049459270869982429_hu4851111231393979208.webp 1200w, /TIM%E6%88%AA%E5%9B%BE20181007214548_1049459270869982429_hu5441252764777873329.webp 1600w\"  alt=\"image\" height=\"745\" width=\"994\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e进入 u 盘驱动界面,系统默认会选择 C 盘为系统盘,直接点击确定\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214933_6020653900508660946.jpg\" title=\"image\" data-thumbnail=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214933_6020653900508660946.jpg\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214933_6020653900508660946.jpg srcset=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214933_6020653900508660946_hu4951951847606821091.webp 800w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214933_6020653900508660946_hu12086769541260579184.webp 1200w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007214933_6020653900508660946_hu1372985651704044730.webp 1600w\"  alt=\"image\" height=\"1080\" width=\"1443\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e确定后进入格式化 C 盘阶段,所有配置为默认配置,直接确定,等待格式化完成!\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215302_7535881699937260138.jpg\" title=\"image\" data-thumbnail=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215302_7535881699937260138.jpg\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215302_7535881699937260138.jpg srcset=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215302_7535881699937260138_hu2062303087294753899.webp 800w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215302_7535881699937260138_hu17195793968796974985.webp 1200w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215302_7535881699937260138_hu1656260736064946211.webp 1600w\"  alt=\"image\" height=\"1080\" width=\"1443\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e格式化完成后选择 是 重启电脑,\u003cstrong\u003e拔出 u 盘\u003c/strong\u003e 等待电脑重启\u003c/p\u003e\n\u003ch2 id=\"安装系统完成\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%ae%89%e8%a3%85%e7%b3%bb%e7%bb%9f%e5%ae%8c%e6%88%90\" class=\"header-mark\"\u003e\u003c/a\u003e3 安装系统完成\u003c/h2\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215500_1778361574818641789.jpg\" title=\"image\" data-thumbnail=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215500_1778361574818641789.jpg\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215500_1778361574818641789.jpg srcset=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215500_1778361574818641789_hu4253811666166933055.webp 800w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215500_1778361574818641789_hu11052628086040657084.webp 1200w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215500_1778361574818641789_hu932083333589616493.webp 1600w\"  alt=\"image\" height=\"1080\" width=\"1443\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215505_16984574416212378428.jpg\" title=\"image\" data-thumbnail=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215505_16984574416212378428.jpg\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003eimage\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215505_16984574416212378428.jpg srcset=\"/%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215505_16984574416212378428_hu17945150598187095457.webp 800w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215505_16984574416212378428_hu14264794176126872764.webp 1200w, /%E5%BE%AE%E4%BF%A1%E5%9B%BE%E7%89%87_20181007215505_16984574416212378428_hu60430275995152624.webp 1600w\"  alt=\"image\" height=\"1080\" width=\"1443\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"winntsetup-使用\" class=\"headerLink\"\u003e\n    \u003ca href=\"#winntsetup-%e4%bd%bf%e7%94%a8\" class=\"header-mark\"\u003e\u003c/a\u003e4 WinNTSetup 使用\u003c/h2\u003e\u003cp\u003e最新的大白菜桌面是这样\u0026#x1f447;\u003c/p\u003e\n\u003cdiv align=\"center\"\u003e\u003cimg src=\"https://cdn.xiaobinqt.cn/xiaobinqt.io/20230320/533790d147e3404fa9e457357d5aab5f.jpg?imageView2/0/q/75|watermark/2/text/eGlhb2JpbnF0/font/dmlqYXlh/fontsize/1000/fill/IzVDNUI1Qg==/dissolve/52/gravity/SouthEast/dx/15/dy/15\" width=400  /\u003e\u003c/div\u003e\n\u003cp\u003e可以使用 WinNTSetup 安装纯净版系统。双击 WinNTSetup 进入，选择 windows 安装源为下载的 ISO 镜像，选择引导驱动器和安装驱动器盘符。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/1a6fa186dda6407f86f4a16dcc531484_9376461094984373039.jpg\" title=\"\" data-thumbnail=\"/1a6fa186dda6407f86f4a16dcc531484_9376461094984373039.jpg\" data-sub-html=\"\u003ch2\u003e使用 WinNTSetup\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/1a6fa186dda6407f86f4a16dcc531484_9376461094984373039.jpg srcset=\"/1a6fa186dda6407f86f4a16dcc531484_9376461094984373039_hu6381722916298159580.webp 800w, /1a6fa186dda6407f86f4a16dcc531484_9376461094984373039_hu2526327354541012636.webp 1200w, /1a6fa186dda6407f86f4a16dcc531484_9376461094984373039_hu16696112555983223767.webp 1600w\"   height=\"1280\" width=\"1706\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e使用 WinNTSetup\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"系统激活\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e7%b3%bb%e7%bb%9f%e6%bf%80%e6%b4%bb\" class=\"header-mark\"\u003e\u003c/a\u003e5 系统激活\u003c/h2\u003e\u003col\u003e\n\u003cli\u003e进入系统后按 Win+X 键，选择命令提示符（管理员）\u003c/li\u003e\n\u003cli\u003e复制以下内容并运行\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - htt