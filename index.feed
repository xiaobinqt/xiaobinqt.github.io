48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-18\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"c\"\u003e# 下载镜像\u003c/span\u003e\u003cspan class=\"err\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"err\"\u003e\u003c/span\u003edocker pull nginx:1.12\u003cspan class=\"err\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"err\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"err\"\u003e\u003c/span\u003e\u003cspan class=\"c\"\u003e# 运行容器\u003c/span\u003e\u003cspan class=\"err\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"err\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"err\"\u003e\u003c/span\u003edocker run --name mynginx -d nginx:1.12\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/39577e6404624bfeba82a985652b7103_7528178658076211696.png\" title=\"下载镜像并启动容器\" data-thumbnail=\"/39577e6404624bfeba82a985652b7103_7528178658076211696.png\" data-sub-html=\"\u003ch2\u003e下载镜像并启动容器\u003c/h2\u003e\u003cp\u003e下载镜像并启动容器\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/39577e6404624bfeba82a985652b7103_7528178658076211696.png srcset=\"/39577e6404624bfeba82a985652b7103_7528178658076211696_hu1626696450925940100.webp 800w, /39577e6404624bfeba82a985652b7103_7528178658076211696_hu14128665072389958666.webp 1200w, /39577e6404624bfeba82a985652b7103_7528178658076211696_hu3485725874663930027.webp 1600w\"  alt=\"下载镜像并启动容器\" height=\"301\" width=\"983\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e下载镜像并启动容器\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e通过 \u003ccode\u003edocker exec\u003c/code\u003e 进入容器，并在 /root 目录下新增 hw.txt 文件，文件内容为 \u003ccode\u003ehello world\u003c/code\u003e：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/17f756252ad3482480613efb90087efd_6883473794261880065.png\" title=\"添加新文件\" data-thumbnail=\"/17f756252ad3482480613efb90087efd_6883473794261880065.png\" data-sub-html=\"\u003ch2\u003e添加新文件\u003c/h2\u003e\u003cp\u003e添加新文件\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/17f756252ad3482480613efb90087efd_6883473794261880065.png srcset=\"/17f756252ad3482480613efb90087efd_6883473794261880065_hu14954648017965984780.webp 800w, /17f756252ad3482480613efb90087efd_6883473794261880065_hu16741730495565063217.webp 1200w, /17f756252ad3482480613efb90087efd_6883473794261880065_hu351379910858817360.webp 1600w\"  alt=\"添加新文件\" height=\"210\" width=\"500\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e添加新文件\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e将这个改动后的容器保存为新的镜像，\u003ccode\u003edocker commit\u003c/code\u003e提交这次修改，提交容器更新后产生的镜像并没 \u003ccode\u003eREPOSITORY\u003c/code\u003e 和 \u003ccode\u003eTAG\u003c/code\u003e\n的内容，也就是说，这个新的镜像还没有名字。可以使用 \u003ccode\u003edocker tag\u003c/code\u003e\n给新镜像命名。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/ff0c45e23ed1400487138fcc6c290a78_13242615020524539445.png\" title=\"提交修改生成新镜像\" data-thumbnail=\"/ff0c45e23ed1400487138fcc6c290a78_13242615020524539445.png\" data-sub-html=\"\u003ch2\u003e提交修改生成新镜像\u003c/h2\u003e\u003cp\u003e提交修改生成新镜像\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/ff0c45e23ed1400487138fcc6c290a78_13242615020524539445.png srcset=\"/ff0c45e23ed1400487138fcc6c290a78_13242615020524539445_hu12179813347189726661.webp 800w, /ff0c45e23ed1400487138fcc6c290a78_13242615020524539445_hu9950191982434586934.webp 1200w, /ff0c45e23ed1400487138fcc6c290a78_13242615020524539445_hu2950234813777401378.webp 1600w\"  alt=\"提交修改生成新镜像\" height=\"682\" width=\"803\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e提交修改生成新镜像\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"存出载入镜像\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%ad%98%e5%87%ba%e8%bd%bd%e5%85%a5%e9%95%9c%e5%83%8f\" class=\"header-mark\"\u003e\u003c/a\u003e5.2 存出载入镜像\u003c/h3\u003e\u003cp\u003e对于某个镜像我们可以导出成一个 tar 包，也可以将一个 tar 镜像导入到系统中。\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003edocker save -o\u003c/code\u003e 命令可以将一个镜像导出为 tar 包\u0026#x1f447;\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/a28fbe578b704a16b618a051838c19e1_5268419084143001721.png\" title=\"导出镜像\" data-thumbnail=\"/a28fbe578b704a16b618a051838c19e1_5268419084143001721.png\" data-sub-html=\"\u003ch2\u003e导出镜像\u003c/h2\u003e\u003cp\u003e导出镜像\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/a28fbe578b704a16b618a051838c19e1_5268419084143001721.png srcset=\"/a28fbe578b704a16b618a051838c19e1_5268419084143001721_hu4480100148815605874.webp 800w, /a28fbe578b704a16b618a051838c19e1_5268419084143001721_hu12419676131979509860.webp 1200w, /a28fbe578b704a16b618a051838c19e1_5268419084143001721_hu16353898240095710869.webp 1600w\"  alt=\"导出镜像\" height=\"363\" width=\"715\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e导出镜像\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e可以通过\u003ccode\u003edocker load\u003c/code\u003e 导入一个 tar 包为镜像，以下删除了原有的 nginx-v2 镜像，通过 nginx-v2.tar 成功导入了 nginx-v2 镜像。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/6843de674516449f85ab8186120c96f4_14291299948085930609.png\" title=\"导入镜像\" data-thumbnail=\"/6843de674516449f85ab8186120c96f4_14291299948085930609.png\" data-sub-html=\"\u003ch2\u003e导入镜像\u003c/h2\u003e\u003cp\u003e导入镜像\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/6843de674516449f85ab8186120c96f4_14291299948085930609.png srcset=\"/6843de674516449f85ab8186120c96f4_14291299948085930609_hu14824095794156106786.webp 800w, /6843de674516449f85ab8186120c96f4_14291299948085930609_hu12928700557959974844.webp 1200w, /6843de674516449f85ab8186120c96f4_14291299948085930609_hu1848456275683318059.webp 1600w\"  alt=\"导入镜像\" height=\"1008\" width=\"979\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e导入镜像\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e利用导入的 nginx-v2 镜像启动一个新容器 mynginxv2，在新容器中的 /root 就会有一个 hw.txt 新文件，内容为 \u003ccode\u003ehello world\u003c/code\u003e：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/29efb46165124cbf9eb9fbb668dad3c8_13790777955102347111.png\" title=\"新镜像\" data-thumbnail=\"/29efb46165124cbf9eb9fbb668dad3c8_13790777955102347111.png\" data-sub-html=\"\u003ch2\u003e新镜像\u003c/h2\u003e\u003cp\u003e新镜像\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/29efb46165124cbf9eb9fbb668dad3c8_13790777955102347111.png srcset=\"/29efb46165124cbf9eb9fbb668dad3c8_13790777955102347111_hu2144524639087845480.webp 800w, /29efb46165124cbf9eb9fbb668dad3c8_13790777955102347111_hu17790127966311842561.webp 1200w, /29efb46165124cbf9eb9fbb668dad3c8_13790777955102347111_hu15533877398034692779.webp 1600w\"  alt=\"新镜像\" height=\"209\" width=\"969\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e新镜像\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"dockerfile\" class=\"headerLink\"\u003e\n    \u003ca href=\"#dockerfile\" class=\"header-mark\"\u003e\u003c/a\u003e6 Dockerfile\u003c/h2\u003e\u003cp\u003e利用 Dockerfile 文件可以生成镜像，这对于自定义镜像非常优雅，也利于镜像分享，直接分享 Dockerfile 文件就可以了。\u003c/p\u003e\n\u003ch3 id=\"常用指令\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%b8%b8%e7%94%a8%e6%8c%87%e4%bb%a4\" class=\"header-mark\"\u003e\u003c/a\u003e6.1 常用指令\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/02c21142855e479a8826db7fcfbd438d_6028095611324547179.png\" title=\"常用指令\" data-thumbnail=\"/02c21142855e479a8826db7fcfbd438d_6028095611324547179.png\" data-sub-html=\"\u003ch2\u003e常用指令\u003c/h2\u003e\u003cp\u003e常用指令\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/02c21142855e479a8826db7fcfbd438d_6028095611324547179.png srcset=\"/02c21142855e479a8826db7fcfbd438d_6028095611324547179_hu663108517344436440.webp 800w, /02c21142855e479a8826db7fcfbd438d_6028095611324547179_hu17302786530921679568.webp 1200w, /02c21142855e479a8826db7fcfbd438d_6028095611324547179_hu18069730414731188125.webp 1600w\"  alt=\"常用指令\" height=\"610\" width=\"1000\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e常用指令\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003eOnly the instructions \u003ccode\u003eRUN\u003c/code\u003e, \u003ccode\u003eCOPY\u003c/code\u003e, \u003ccode\u003eADD\u003c/code\u003e create layers. Other instructions create temporary intermediate images, and do not increase the size of the build.\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003cp\u003e只有 RUN, COPY, ADD 会生成新的镜像层，其它指令只会产生临时层，不影响构建大小。\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u0026#x1f3c6;\u003ccode\u003eFROM\u003c/code\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e通过 \u003ccode\u003eFROM\u003c/code\u003e 指令指定一个基础镜像，接下来所有的指令都是基于这个镜像所展开的。\n\u003cstrong\u003e为了保证镜像精简，可以选用体积较小的镜像如\u003ccode\u003eAlpine\u003c/code\u003e或\u003ccode\u003eDebian\u003c/code\u003e作为基础镜像\u003c/strong\u003e。\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003eFROM\u003c/code\u003e 指令支持三种形式：\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003eshell\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.7