h\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -v\u003c/code\u003e 或 \u003ccode\u003ephp --version\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e查看当前安装的 PHP 版本\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -v\u003c/code\u003e\u003cbr\u003e输出：\u003ccode\u003ePHP 8.4.0 (cli) (built: Jan  1 2023)\u003c/code\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -m\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e查看当前加载的 PHP 扩展\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -m\u003c/code\u003e\u003cbr\u003e输出：列出所有已加载的扩展\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -i\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e显示详细的 PHP 配置信息，包括 PHP 的信息、扩展等\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -i\u003c/code\u003e\u003cbr\u003e输出：详细的 PHP 配置信息\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -l \u0026lt;file\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e检查指定 PHP 文件的语法错误\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -l test.php\u003c/code\u003e\u003cbr\u003e输出：\u003ccode\u003eNo syntax errors detected\u003c/code\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -r \u0026lt;code\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e直接执行 PHP 代码（无需创建文件）\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -r 'echo \u0026quot;Hello, world!\u0026quot;;'\u003c/code\u003e\u003cbr\u003e输出：\u003ccode\u003eHello, world!\u003c/code\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -S \u0026lt;host\u0026gt;:\u0026lt;port\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e启动 PHP 内置 Web 服务器\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -S localhost:8080\u003c/code\u003e\u003cbr\u003e启动内置服务器\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -a\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e启动 PHP 交互模式（REPL）\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -a\u003c/code\u003e\u003cbr\u003e进入交互模式并直接执行 PHP 代码\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -d \u0026lt;directive\u0026gt;=\u0026lt;value\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e临时修改 PHP 配置指令的值（不会改变 \u003ccode\u003ephp.ini\u003c/code\u003e 配置文件）\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -d display_errors=1 script.php\u003c/code\u003e\u003cbr\u003e启用错误显示\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -c \u0026lt;path_to_php.ini\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e指定使用的 \u003ccode\u003ephp.ini\u003c/code\u003e 配置文件路径\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -c /path/to/custom/php.ini -m\u003c/code\u003e\u003cbr\u003e使用自定义的 \u003ccode\u003ephp.ini\u003c/code\u003e\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -h\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e查看 PHP 命令行的帮助信息，列出所有可用的命令选项\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -h\u003c/code\u003e\u003cbr\u003e显示所有 PHP 命令行选项\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -z \u0026lt;file\u0026gt;\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e加载指定的 Zend 扩展\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp -z /path/to/zend_extension.so\u003c/code\u003e\u003cbr\u003e加载扩展\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp-fpm\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e管理 PHP FastCGI 进程管理器（用于 Web 服务器）\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003esudo systemctl restart php8.4-fpm\u003c/code\u003e\u003cbr\u003e重启 PHP-FPM\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp-config\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e显示与 PHP 配置相关的信息，通常用于编译 PHP 扩展时获取配置参数\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003ephp-config --help\u003c/code\u003e\u003cbr\u003e显示配置参数\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003ch2 id=\"参考\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%8f%82%e8%80%83\" class=\"header-mark\"\u003e\u003c/a\u003e7 参考\u003c/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://wiki.swoole.com/zh-cn/#/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eswoole 文档 https://wiki.swoole.com/zh-cn/#/\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "Ubuntu 22.04.5 LTS 部署 mongo 一主二从一选举",
        "date_published" : "2024-09-11T00:00:00Z",
        "date_modified" : "2025-02-20T19:08:00+08:00",
        "id" : "https://www.xiaobinqt.cn/wsl-mongodb-master-slave/",
        "url" : "https://www.xiaobinqt.cn/wsl-mongodb-master-slave/",
        "summary": " 1 安装 mongosh 入 MongoDB GPG 密钥 bash\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003c!-- author： xiaobinqt --\u003e\n\u003c!-- email： xiaobinqt@163.com --\u003e\n\u003c!-- https://xiaobinqt.github.io --\u003e\n\u003c!-- https://www.xiaobinqt.cn --\u003e\n\u003ch2 id=\"安装-mongosh\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%ae%89%e8%a3%85-mongosh\" class=\"header-mark\"\u003e\u003c/a\u003e1 安装 mongosh\u003c/h2\u003e\u003col\u003e\n\u003cli\u003e入 MongoDB GPG 密钥\u003c/li\u003e\n\u003c/ol\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003ebash\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]