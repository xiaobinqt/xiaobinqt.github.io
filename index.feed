003ccode \n    id=\"codeblock-id-1\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003edocker \u003cspan class=\"nb\"\u003eexec\u003c/span\u003e \u003cspan class=\"o\"\u003e[\u003c/span\u003e-i\u003cspan class=\"o\"\u003e]\u003c/span\u003e 容器名 命令\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/0b8a159e61264e45ae982fcfd8418016_2058682463768391551.png\" title=\"docker exec\" data-thumbnail=\"/0b8a159e61264e45ae982fcfd8418016_2058682463768391551.png\" data-sub-html=\"\u003ch2\u003edocker exec\u003c/h2\u003e\u003cp\u003edocker exec\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/0b8a159e61264e45ae982fcfd8418016_2058682463768391551.png srcset=\"/0b8a159e61264e45ae982fcfd8418016_2058682463768391551_hu16661902415523829489.webp 800w, /0b8a159e61264e45ae982fcfd8418016_2058682463768391551_hu18371940248945288291.webp 1200w, /0b8a159e61264e45ae982fcfd8418016_2058682463768391551_hu11203182656729159323.webp 1600w\"  alt=\"docker exec\" height=\"249\" width=\"577\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003edocker exec\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003e--rm\u003c/code\u003e 选项参数，可以让容器在停止后自动删除，不需要再使用容器删除命令来删除，对临时容器友好\u0026#x1f447;。\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n    