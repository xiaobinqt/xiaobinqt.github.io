on/json\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e// @Produce application/json\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e// @Param  user_id path string \u003cspan class=\"nb\"\u003etrue\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;用户ID\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e// @Param  search query string \u003cspan class=\"nb\"\u003efalse\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;搜索内容\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e// @Param data body Req \u003cspan class=\"nb\"\u003etrue\u003c/span\u003e \u003cspan class=\"s2\"\u003e\u0026#34;email: 用户名，password: 密码\u0026#34;\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e// @Success \u003cspan class=\"m\"\u003e200\u003c/span\u003e \u003cspan class=\"o\"\u003e{\u003c/span\u003eobject\u003cspan class=\"o\"\u003e}\u003c/span\u003e EdgeInstanceList\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e// @Router /api/login/\u003cspan class=\"o\"\u003e{\u003c/span\u003euser_id\u003cspan class=\"o\"\u003e}\u003c/span\u003e \u003cspan class=\"o\"\u003e[\u003c/span\u003ePOST\u003cspan class=\"o\"\u003e]\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003efunc Login\u003cspan class=\"o\"\u003e(\u003c/span\u003ew http.ResponseWriter, r *http.Request\u003cspan class=\"o\"\u003e)\u003c/span\u003e \u003cspan class=\"o\"\u003e{\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\tw.Write\u003cspan class=\"o\"\u003e([]\u003c/span\u003ebyte\u003cspan class=\"o\"\u003e(\u003c/span\u003e\u003cspan class=\"s2\"\u003e\u0026#34;hello\u0026#34;\u003c/span\u003e\u003cspan class=\"o\"\u003e))\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"o\"\u003e}\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e46042ea6a5e4ce8bd4c85ec34223d9f_14500925871236426804.png\" title=\"效果_01\" data-thumbnail=\"/e46042ea6a5e4ce8bd4c85ec34223d9f_14500925871236426804.png\" data-sub-html=\"\u003ch2\u003e效果_01\u003c/h2\u003e\u003cp\u003e效果_01\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e46042ea6a5e4ce8bd4c85ec34223d9f_14500925871236426804.png srcset=\"/e46042ea6a5e4ce8bd4c85ec34223d9f_14500925871236426804_hu15640646656088292094.webp 800w, /e46042ea6a5e4ce8bd4c85ec34223d9f_14500925871236426804_hu7441261826213388837.webp 1200w, /e46042ea6a5e4ce8bd4c85ec34223d9f_14500925871236426804_hu12903808175117618251.webp 1600w\"  alt=\"效果_01\" height=\"935\" width=\"1443\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e效果_01\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/c068d1585a49494992af4e7993a5a4f8_12475105823460254471.png\" title=\"效果_02\" data-thumbnail=\"/c068d1585a49494992af4e7993a5a4f8_12475105823460254471.png\" data-sub-html=\"\u003ch2\u003e效果_02\u003c/h2\u003e\u003cp\u003e效果_02\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/c068d1585a49494992af4e7993a5a4f8_12475105823460254471.png srcset=\"/c068d1585a49494992af4e7993a5a4f8_12475105823460254471_hu98584180620257199.webp 800w, /c068d1585a49494992af4e7993a5a4f8_12475105823460254471_hu14366165454783772730.webp 1200w, /c068d1585a49494992af4e7993a5a4f8_12475105823460254471_hu642778829898204100.webp 1600w\"  alt=\"效果_02\" height=\"696\" width=\"1428\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e效果_02\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"参考\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%8f%82%e8%80%83\" class=\"header-mark\"\u003e\u003c/a\u003e5 参考\u003c/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://github.com/xiaobinqt/go.src/tree/master/dev/martini-swagger\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e\u0026#x261d;\u0026#xfe0f;文章示例源码\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://swagger.io/docs/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eswagger官方文档\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://github.com/swaggo/swag/blob/master/README_zh-CN.md\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://github.com/swaggo/swag/blob/master/README_zh-CN.md\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://www.jianshu.com/p/9313d0c5395d\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://www.jianshu.com/p/9313d0c5395d\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://colobu.com/2021/01/17/go-embed-tutorial/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eGo embed 简明教程\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://zhuanlan.zhihu.com/p/351931501\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eGo 1.16新特性-embed包及其使用\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "工作中问题总结",
        "date_published" : "2021-12-20T00:00:00Z",
        "date_modified" : "2023-09-12T16:56:41+08:00",
        "id" : "https://www.xiaobinqt.cn/problems-in-work/",
        "url" : "https://www.xiaobinqt.cn/problems-in-work/",
        "summary": " 1 缘起那天面试一家公司，面试的人问我工作内容，我说大部分时间就是写业务。好吧，我承认我是个菜鸡。然后他问，找个你工作中遇到的问题和解决的过程来谈一谈。我想了下说，大部分问题 google 下都能解决，没有什么特别复杂的，大部分问题前人都有解决方法，有些问题可能是之前没有接触过，所以花的时间比较长。\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003c!-- author： xiaobinqt --\u003e\n\u003c!-- email： xiaobinqt@163.com --\u003e\n\u003c!-- https://xiaobinqt.github.io --\u003e\n\u003c!-- https://www.xiaobinqt.cn --\u003e\n\u003ch2 id=\"缘起\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e7%bc%98%e8%b5%b7\" class=\"header-mark\"\u003e\u003c/a\u003e1 缘起\u003c/h2\u003e\u003cp\u003e那天面试一家公司，面试的人问我工作内容，我说大部分时间就是写业务。好吧，我承认我是个菜鸡。然后他问，找个你工作中遇到的问题和解决的过程来谈一谈。我想了下说，大部分问题 google 下都能解决，没有什么特别复杂的，大部分问题前人都有解决方法，有些问题可能是之前没有接触过，所以花的时间比较长。\u003c/p\u003e\n\u003cp\u003e我当时心里有一万匹草泥马走过。现在我™就给你们这些大爷总结下，我这个菜鸡工作中遇到的问题，并且如何解决这些问题的，我谢谢你们\u0026#x1f607;\u0026#x1f607;。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/3c16037e9aac4bfe9dc0400fa2c3ee01_7650323105787872819.png\" title=\"CV工程师\" data-thumbnail=\"/3c16037e9aac4bfe9dc0400fa2c3ee01_7650323105787872819.png\" data-sub-html=\"\u003ch2\u003eCV工程师\u003c/h2\u003e\u003cp\u003eCV工程师\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/3c16037e9aac4bfe9dc0400fa2c3ee01_7650323105787872819.png srcset=\"/3c16037e9aac4bfe9dc0400fa2c3ee01_7650323105787872819_hu11514007292233739782.webp 800w, /3c16037e9aac4bfe9dc0400fa2c3ee01_7650323105787872819_hu9976786760181452471.webp 1200w, /3c16037e9aac4bfe9dc0400fa2c3ee01_7650323105787872819_hu5784963625438529946.webp 1600w\"  alt=\"CV工程师\" height=\"395\" width=\"600\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eCV工程师\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"go-bindata改成embed\" class=\"headerLink\"\u003e\n    \u003ca href=\"#go-bindata%e6%94%b9%e6%88%90embed\" class=\"header-mark\"\u003e\u003c/a\u003e2 go-bindata改成embed\u003c/h2\u003e\u003cp\u003e公司有个老项目用的是 \u003ca href=\"https://github.com/go-bindata/go-bindata\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ego-bindata\u003c/a\u003e 将前端打包到二进制里的。go-bindata 太老了，它的出现出现是由于 Go 之前版本官方不支持资源嵌入，但是 Go1.16 之后，官方推出了\u003ccode\u003eembed\u003c/code\u003e解决了资源嵌入问题，个人觉得至此之后，类似 go-bindata 社区维护的资源嵌入工具会慢慢退出历史舞台。\u003c/p\u003e\n\u003cp\u003e关于\u003ccode\u003eembed\u003c/code\u003e的使用可以参看\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://colobu.com/2021/01/17/go-embed-tutorial/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eGo embed 简明教程\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://zhuanlan.zhihu.com/p/351931501\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eGo 1.16新特性-embed包及其使用\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e这是我的使用\u0026#x1f447;\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003ego\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select