icense/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-1\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eyum install -y net-tools\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/d77b3da7989f4020b5d9a7ee9574e719_6764033169638916058.png\" title=\"net-tools install\" data-thumbnail=\"/d77b3da7989f4020b5d9a7ee9574e719_6764033169638916058.png\" data-sub-html=\"\u003ch2\u003enet-tools install\u003c/h2\u003e\u003cp\u003enet-tools install\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/d77b3da7989f4020b5d9a7ee9574e719_6764033169638916058.png srcset=\"/d77b3da7989f4020b5d9a7ee9574e719_6764033169638916058_hu7347150390871579859.webp 800w, /d77b3da7989f4020b5d9a7ee9574e719_6764033169638916058_hu17963396661535686758.webp 1200w, /d77b3da7989f4020b5d9a7ee9574e719_6764033169638916058_hu11820191104168230973.webp 1600w\"  alt=\"net-tools install\" height=\"629\" width=\"869\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003enet-tools install\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/3e3b4820d5ac4ce0b5883f0be3e547e1_11924256174473721098.png\" title=\"ifconfig\" data-thumbnail=\"/3e3b4820d5ac4ce0b5883f0be3e547e1_11924256174473721098.png\" data-sub-html=\"\u003ch2\u003eifconfig\u003c/h2\u003e\u003cp\u003eifconfig\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/3e3b4820d5ac4ce0b5883f0be3e547e1_11924256174473721098.png srcset=\"/3e3b4820d5ac4ce0b5883f0be3e547e1_11924256174473721098_hu10374914154839154750.webp 800w, /3e3b4820d5ac4ce0b5883f0be3e547e1_11924256174473721098_hu2303656890573534240.webp 1200w, /3e3b4820d5ac4ce0b5883f0be3e547e1_11924256174473721098_hu17551631521153122925.webp 1600w\"  alt=\"ifconfig\" height=\"384\" width=\"680\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eifconfig\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"修改网卡为-eth0\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%bf%ae%e6%94%b9%e7%bd%91%e5%8d%a1%e4%b8%ba-eth0\" class=\"header-mark\"\u003e\u003c/a\u003e5 修改网卡为 eth0\u003c/h2\u003e\u003cp\u003eCentOS 7.x 的网卡不是 eth0 而是 ensxx，这是 CentOS 7.x 的一致性网络设备命名导致的，可以使用以下方式，将网卡名称回到 eth0 格式。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/031a5551677449d8a3e83f3dc02a3562_6649981294315285449.png\" title=\"ensxx\" data-thumbnail=\"/031a5551677449d8a3e83f3dc02a3562_6649981294315285449.png\" data-sub-html=\"\u003ch2\u003eensxx\u003c/h2\u003e\u003cp\u003eensxx\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/031a5551677449d8a3e83f3dc02a3562_6649981294315285449.png srcset=\"/031a5551677449d8a3e83f3dc02a3562_6649981294315285449_hu16143764243218063541.webp 800w, /031a5551677449d8a3e83f3dc02a3562_6649981294315285449_hu16532668557532240452.webp 1200w, /031a5551677449d8a3e83f3dc02a3562_6649981294315285449_hu4339989731410688278.webp 1600w\"  alt=\"ensxx\" height=\"387\" width=\"795\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eensxx\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e修改配置\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-