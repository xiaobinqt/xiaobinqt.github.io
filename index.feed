39.56-21.36 0-33.8 10-40.46 18.75-4.37 5.59-3 10.84 2.8 15.37l8.58 6.88c5.61 4.56 11 2.47 16.12-2.44a13.44 13.44 0 0 1 9.46-3.84c3.33 0 9.28 1.56 9.28 8.75C51 248.19 0 257.31 0 304.59v4C0 316 5.08 320 12.09 320z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n      \u003cbutton \n        class=\"\n          wrap-code-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.is-wrap]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle code wrap\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-2\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e数值类型 UNSIGNED\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e可以把它当成一种新类型对待，比如\u003ccode\u003eINT UNSIGNED\u003c/code\u003e就表示无符号整数，\u003ccode\u003eFLOAT UNSIGNED\u003c/code\u003e表示无符号浮点数，\u003ccode\u003eDECIMAL UNSIGNED\u003c/code\u003e表示无符号定点数。\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003e在使用的存储空间大小相同的情况下，无符号整数可以表示的正整数范围比有符号整数能表示的正整数范围大一倍。\n不过受浮点数和定点数具体的存储格式影响，无符号浮点数和定点数并不能提升正数的表示范围。\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003ch2 id=\"时间和日期\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%97%b6%e9%97%b4%e5%92%8c%e6%97%a5%e6%9c%9f\" class=\"header-mark\"\u003e\u003c/a\u003e6 时间和日期\u003c/h2\u003e\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: left\"\u003e类型\u003c/th\u003e\n            \u003cth style=\"text-align: left\"\u003e存储空间\u003c/th\u003e\n            \u003cth style=\"text-align: left\"\u003e取值范围\u003c/th\u003e\n            \u003cth style=\"text-align: left\"\u003e含义\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eYEAR\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e1\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e1901\u003c/code\u003e~\u003ccode\u003e2155\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e年份值\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eDATE\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e3\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e1000-01-01\u003c/code\u003e~\u003ccode\u003e9999-12-31\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e日期值\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eTIME\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e3\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e-838:59:59\u003c/code\u003e~\u003ccode\u003e838:59:59\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e时间值\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eDATETIME\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e8\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e1000-01-01 00:00:00\u003c/code\u003e~\u003ccode\u003e9999-12-31 23:59:59\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e日期加时间值\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eTIMESTAMP\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e4\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e\u003ccode\u003e1970-01-01 00:00:01\u003c/code\u003e~\u003ccode\u003e2038-01-19 03:14:07\u003c/code\u003e\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e时间戳\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003ccode\u003eTIME\u003c/code\u003e表示时间，格式是\u003ccode\u003ehh:mm:ss[.uuuuuu]\u003c/code\u003e或者\u003ccode\u003ehhh:mm:ss[.uuuuuu]\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003e用时间戳存储时间的好处就是，它展示的值可以随着时区的变化而变化。\u003c/p\u003e\n\u003cblockquote\u003e\n  \u003cp\u003eDATETIME 中的时间部分表示的是一天内的时间(00:00:00 ~ 23:59:59)，而 TIME 表示的是一段时间，而且可以表示负值。\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003ch2 id=\"字符串\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%ad%97%e7%ac%a6%e4%b8%b2\" class=\"header-mark\"\u003e\u003c/a\u003e7 字符串\u003c/h2\u003e\n\u003cdiv class=\"table-wrapper\"\u003e\n  \u003ctable\u003e\n    \u003cthead\u003e\n        \u003ctr\u003e\n            \u003cth style=\"text-align: left\"\u003e类型\u003c/th\u003e\n            \u003cth style=\"text-align: left\"\u003e最大长度\u003c/th\u003e\n            \u003cth style=\"text-align: left\"\u003e存储空间要求\u003c/th\u003e\n            \u003cth style=\"text-align: left\"\u003e含义\u003c/th\u003e\n        \u003c/tr\u003e\n    \u003c/thead\u003e\n    \u003ctbody\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eCHAR(M)\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eM个字符\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eM×W个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e固定长度的字符串\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eVARCHAR(M)\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eM个字符\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eL+1 或 L+2 个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e可变长度的字符串\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eTINYTEXT\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e2⁸-1 个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eL+1个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e非常小型的字符串\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eTEXT\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e2¹⁶-1 个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eL+2 个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e小型的字符串\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eMEDIUMTEXT\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e2²⁴-1 个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eL+3个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e中等大小的字符串\u003c/td\u003e\n        \u003c/tr\u003e\n        \u003ctr\u003e\n            \u003ctd style=\"text-align: left\"\u003eLONGTEXT\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e2³²-1 个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003eL+4个字节\u003c/td\u003e\n            \u003ctd style=\"text-align: left\"\u003e大型的字符串\u003c/td\u003e\n        \u003c/tr\u003e\n    \u003c/tbody\u003e\n  \u003c/table\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003ccode\u003eM\u003c/code\u003e 代表该数据类型最多能存储的字符数量，\u003ccode\u003eL\u003c/code\u003e 代表我们实际向该类型的属性中存储的字符串在特定字符集下所占的字节数，\u003ccode\u003eW\u003c/code\u003e代表在该特定字符集下，编码一个字符最多需要的字节数。\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003eVARCHAR(M)\u003c/code\u003e 中的\u003ccode\u003eM\u003c/code\u003e也是代表该类型最多可以存储的字符数量，理论上的取值范围是 1~65535。但是MySQL中还有一个规定，表中某一行包含的所有列中存储的数据大小总共不得超过 65535\n个字节，也就是说 \u003cstrong\u003e\u003ccode\u003eVARCHAR(M)\u003c/code\u003e\n类型实际能够容纳的字符数量是小于 65535 的\u003c/strong\u003e。\u003c/p\u003e\n\u003ch2 id=\"参考\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%8f%82%e8%80%83\" class=\"header-mark\"\u003e\u003c/a\u003e8 参考\u003c/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://tool.oschina.net/hexconvert/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e在线进制转换\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://juejin.cn/book/6844733802426662926/section/6844733802611245070\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eMySQL数据类型\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "阿里云 SSL 免费证书使用",
        "date_published" : "2019-06-07T00:00:00Z",
        "date_modified" : "2023-05-18T14:47:05+08:00",
        "id" : "https://www.xiaobinqt.cn/ali-ssl/",
        "url" : "https://www.xiaobinqt.cn/ali-ssl/",
        "summary": " 1 申请证书申请地址\n申请完成页面\n将主机记录解析\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003ch2 id=\"申请\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e7%94%b3%e8%af%b7\" class=\"header-mark\"\u003e\u003c/a\u003e1 申请\u003c/h2\u003e\u003cp\u003e证书\u003ca href=\"https://common-buy.aliyun.com/?spm=5176.2020520163.cas.20.165a56a7xopCbo\u0026amp;commodityCode=cas#/buy\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e申请地址\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/af2d82e50c1d4f81b8d878a5ce6ee92f_17237659430708913516.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/af2d82e50c1d4f81b8d878a5ce6ee92f_17237659430708913516.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/af2d82e50c1d4f81b8d878a5ce6ee92f_17237659430708913516.png srcset=\"/af2d82e50c1d4f81b8d878a5ce6ee92f_17237659430708913516_hu6281817535127149840.webp 800w, /af2d82e50c1d4f81b8d878a5ce6ee92f_17237659430708913516_hu9367908697325621714.webp 1200w, /af2d82e50c1d4f81b8d878a5ce6ee92f_17237659430708913516_hu15980034374018941160.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"668\" width=\"1370\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e申请完成页面\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/8fa701498a7748cd8ec53c5acc80eb25_15367500202580937760.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/8fa701498a7748cd8ec53c5acc80eb25_15367500202580937760.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/8fa701498a7748cd8ec53c5acc80eb25_15367500202580937760.png srcset=\"/8fa701498a7748cd8ec53c5acc80eb25_15367500202580937760_hu5823824827773811060.webp 800w, /8fa701498a7748cd8ec53c5acc80eb25_15367500202580937760_hu17777506778113328754.webp 1200w, /8fa701498a7748cd8ec53c5acc80eb25_15367500202580937760_hu13572975222757048355.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"531\" width=\"1128\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e将主机记录解析\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/d1d6c628525f4214a7ac654228401539_3674041210859004773.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/d1d6c628525f4214a7ac654228401539_3674041210859004773.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/d1d6c628525f4214a7ac654228401539_3674041210859004773.png srcset=\"/d1d6c628525f4214a7ac654228401539_3674041210859004773_hu11606600971826030031.webp 800w, /d1d6c628525f4214a7ac654228401539_3674041210859004773_hu9116543450603895488.webp 1200w, /d1d6c628525f4214a7ac654228401539_3674041210859004773_hu3052218995043352152.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"592\" width=\"492\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/550891bae21245c6aa955c1060ca44b2_9658783291632662463.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/550891bae21245c6aa955c1060ca44b2_9658783291632662463.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/550891bae21245c6aa955c1060ca44b2_9658783291632662463.png srcset=\"/550891bae21245c6aa955c1060ca44b2_9658783291632662463_hu817760943278508353.webp 800w, /550891bae21245c6aa955c1060ca44b2_9658783291632662463_hu14356881776278095278.webp 1200w, /550891bae21245c6aa955c1060ca44b2_9658783291632662463_hu18112171691768785157.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"332\" width=\"1739\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/17a0ae3842ca467b918832e858a48429_4533029130691161575.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/17a0ae3842ca467b918832e858a48429_4533029130691161575.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/17a0ae3842ca467b918832e858a48429_4533029130691161575.png srcset=\"/17a0ae3842ca467b918832e858a48429_4533029130691161575_hu7298075742813802528.webp 800w, /17a0ae3842ca467b918832e858a48429_4533029130691161575_hu7006523337475248120.webp 1200w, /17a0ae3842ca467b918832e858a48429_4533029130691161575_hu7486728910175404028.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"565\" width=\"1170\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e将主机记录和记录值填写\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/60fff0291dc849dd882d8bc4e5bb5dc2_18236560791299632566.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/60fff0291dc849dd882d8bc4e5bb5dc2_18236560791299632566.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/60fff0291dc849dd882d8bc4e5bb5dc2_18236560791299632566.png srcset=\"/60fff0291dc849dd882d8bc4e5bb5dc2_18236560791299632566_hu16995009548010923374.webp 800w, /60fff0291dc849dd882d8bc4e5bb5dc2_18236560791299632566_hu2118486804400014843.webp 1200w, /60fff0291dc849dd882d8bc4e5bb5dc2_18236560791299632566_hu2037985563705681944.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"517\" width=\"1038\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e解析成功后下载证书\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/427ce91858d242669ecdb0c66228dcb7_4026020317796931113.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/427ce91858d242669ecdb0c66228dcb7_4026020317796931113.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/427ce91858d242669ecdb0c66228dcb7_4026020317796931113.png srcset=\"/427ce91858d242669ecdb0c66228dcb7_4026020317796931113_hu13663697224148204726.webp 800w, /427ce91858d242669ecdb0c66228dcb7_4026020317796931113_hu880763270796325531.webp 1200w, /427ce91858d242669ecdb0c66228dcb7_4026020317796931113_hu3511601870246753175.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"291\" width=\"1740\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e我用的是 Apache ,所以下载的是 Apache\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e92feeef5ab6443d98269ae145a913da_6966257528442857642.png\" title=\"在这里插入图片描述\" data-thumbnail=\"/e92feeef5ab6443d98269ae145a913da_6966257528442857642.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\u003cp\u003e在这里插入图片描述\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e92feeef5ab6443d98269ae145a913da_6966257528442857642.png srcset=\"/e92feeef5ab6443d98269ae145a913da_6966257528442857642_hu12233241943186280026.webp 800w, /e92feeef5ab6443d98269ae145a913da_6966257528442857642_hu7528387096943506152.webp 1200w, /e92feeef5ab6443d98269ae145a913da_6966257528442857642_hu6910548881887066194.webp 1600w\"  alt=\"在这里插入图片描述\" height=\"543\" width=\"531\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"上传证书\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%b8%8a%e4%bc%a0%e8%af%81%e4%b9%a6\" class=\"header-mark\"\u003e\u003c/a\u003e2 上传证书\u003c/h2\u003e\u003cp\u003e由于本人使用的是 apache ,以下配置是 apache 的通用配置,具体可参看官方\n\u003ca href=\"https://help.aliyun.com/knowledge_detail/95493.html?spm=5176.2020520163.cas.66.72aa56a7v9JUNG\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e文档\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e在 apache 的路径下新建一个 cert 目录,其实该目录建在哪里都可以,但是放在 apache 下方便管理。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/ce5f177ef433482ab19fb7b48103f1ff_1203432072642325717.png\" title=\"\" data-thumbnail=\"/ce5f177ef433482ab19fb7b48103f1ff_1203432072642325717.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/ce5f177ef433482ab19fb7b48103f1ff_1203432072642325717.png srcset=\"/ce5f177ef433482ab19fb7b48103f1ff_1203432072642325717_hu17789050114511650376.webp 800w, /ce5f177ef433482ab19fb7b48103f1ff_1203432072642325717_hu16718256331369770783.webp 1200w, /ce5f177ef433482ab19fb7b48103f1ff_1203432072642325717_hu17017364866483155628.webp 1600w\"   height=\"276\" width=\"587\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e在 cert 目录下可以建不同的文件夹放在不同域名或子域名的 ssl 文件。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/030ee91945dc4ac0baf3cfb472bf0f29_15398092320123001702.png\" title=\"\" data-thumbnail=\"/030ee91945dc4ac0baf3cfb472bf0f29_15398092320123001702.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/030ee91945dc4ac0baf3cfb472bf0f29_15398092320123001702.png srcset=\"/030ee91945dc4ac0baf3cfb472bf0f29_15398092320123001702_hu4080247571827780502.webp 800w, /030ee91945dc4ac0baf3cfb472bf0f29_15398092320123001702_hu1759545736513212773.webp 1200w, /030ee91945dc4ac0baf3cfb472bf0f29_15398092320123001702_hu8474799937518059282.webp 1600w\"   height=\"141\" width=\"635\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e把我们刚才下载的证书上传到服务器上\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/29efb0e83dd941f5b1fdc616c06baa49_10727461547492603116.png\" title=\"\" data-thumbnail=\"/29efb0e83dd941f5b1fdc616c06baa49_10727461547492603116.png\" data-sub-html=\"\u003ch2\u003e \u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/29efb0e83dd941f5b1fdc616c06baa49_10727461547492603116.png srcset=\"/29efb0e83dd941f5b1fdc616c06baa49_10727461547492603116_hu13902031389390648707.webp 800w, /29efb0e83dd941f5b1fdc616c06baa49_10727461547492603116_hu2204099231724466644.webp 1200w, /29efb0e83dd941f5b1fdc616c06baa49_10727461547492603116_hu18150017336616352268.webp 1600w\"   height=\"153\" width=\"657\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e \u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"配置\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e9%85%8d%e7%bd%ae\" class=\"header-mark\"\u003e\u003c/a\u003e3 配置\u003c/h2\u003e\u003cp\u003e这是基本的配置语句\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003ebash\u003c/p\u003e\n    \u003c/div\u003e\n    \