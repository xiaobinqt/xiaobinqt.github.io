 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-7\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"o\"\u003e[\u003c/span\u003emysqld\u003cspan class=\"o\"\u003e]\u003c/span\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003epid-file        \u003cspan class=\"o\"\u003e=\u003c/span\u003e /var/run/mysqld/mysqld.pid\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nv\"\u003esocket\u003c/span\u003e          \u003cspan class=\"o\"\u003e=\u003c/span\u003e /var/run/mysqld/mysqld.sock\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\u003cspan class=\"nv\"\u003edatadir\u003c/span\u003e         \u003cspan class=\"o\"\u003e=\u003c/span\u003e /var/lib/mysql\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003esecure-file-priv\u003cspan class=\"o\"\u003e=\u003c/span\u003e /var/lib/mysql\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e具体可以参考\u003ca href=\"https://github.com/docker-library/mysql/blob/master/8.0/config/my.cnf\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://github.com/docker-library/mysql/blob/master/8.0/config/my.cnf\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u003ccode\u003esecure-file-priv\u003c/code\u003e 设置为 \u003ccode\u003e/var/lib/mysql\u003c/code\u003e是为了解决 \u003ca href=\"https://github.com/docker-library/mysql/issues/541\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eMySQL 8 docker-compose :Failed to access directory for \u0026ndash;secure-file-priv\u003c/a\u003e 问题。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/014c2fb94bb74b0b8f42178efaff315c_14856298061479413671.png\" title=\"设置挂载目录\" data-thumbnail=\"/014c2fb94bb74b0b8f42178efaff315c_14856298061479413671.png\" data-sub-html=\"\u003ch2\u003e设置挂载目录\u003c/h2\u003e\u003cp\u003e设置挂载目录\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/014c2fb94bb74b0b8f42178efaff315c_14856298061479413671.png srcset=\"/014c2fb94bb74b0b8f42178efaff315c_14856298061479413671_hu18089555094012931105.webp 800w, /014c2fb94bb74b0b8f42178efaff315c_14856298061479413671_hu11444609442100898820.webp 1200w, /014c2fb94bb74b0b8f42178efaff315c_14856298061479413671_hu6048421250439110917.webp 1600w\"  alt=\"设置挂载目录\" height=\"258\" width=\"782\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e设置挂载目录\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"启动容器\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%90%af%e5%8a%a8%e5%ae%b9%e5%99%a8\" class=\"header-mark\"\u003e\u003c/a\u003e3.2 启动容器\u003c/h3\u003e\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003eshell\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 51