 group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003edocker info \u003cspan class=\"p\"\u003e|\u003c/span\u003e grep Mirrors -A \u003cspan class=\"m\"\u003e1\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/bd599a600ab44a73a6f21de4167a4446_15915703404900964400.png\" title=\"查看镜像源\" data-thumbnail=\"/bd599a600ab44a73a6f21de4167a4446_15915703404900964400.png\" data-sub-html=\"\u003ch2\u003e查看镜像源\u003c/h2\u003e\u003cp\u003e查看镜像源\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/bd599a600ab44a73a6f21de4167a4446_15915703404900964400.png srcset=\"/bd599a600ab44a73a6f21de4167a4446_15915703404900964400_hu15525048011603805547.webp 800w, /bd599a600ab44a73a6f21de4167a4446_15915703404900964400_hu4559359066749273459.webp 1200w, /bd599a600ab44a73a6f21de4167a4446_15915703404900964400_hu9470615190558962462.webp 1600w\"  alt=\"查看镜像源\" height=\"104\" width=\"554\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e查看镜像源\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"下载镜像\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%b8%8b%e8%bd%bd%e9%95%9c%e5%83%8f\" class=\"header-mark\"\u003e\u003c/a\u003e2 下载镜像\u003c/h2\u003e\u003cp\u003e可以去 \u003ca href=\"https://hub.docker.com/_/mysql/tags\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://hub.docker.com/_/mysql/tags\u003c/a\u003e 仓库找需要的 mysql 版本\u0026#x1f447;\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/09ed0f1adae443d3a22a34796c8b3c0e_1875569436522867089.png\" title=\"镜像下载\" data-thumbnail=\"/09ed0f1adae443d3a22a34796c8b3c0e_1875569436522867089.png\" data-sub-html=\"\u003ch2\u003e镜像下载\u003c/h2\u003e\u003cp\u003e镜像下载\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/09ed0f1adae443d3a22a34796c8b3c0e_1875569436522867089.png srcset=\"/09ed0f1adae443d3a22a34796c8b3c0e_1875569436522867089_hu3375831362519965794.webp 800w, /09ed0f1adae443d3a22a34796c8b3c0e_1875569436522867089_hu14921216686703985478.webp 1200w, /09ed0f1adae443d3a22a34796c8b3c0e_1875569436522867089_hu6134990152216590029.webp 1600w\"  alt=\"镜像下载\" height=\"712\" width=\"1417\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e镜像下载\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e通过 \u003ccode\u003edocker pull\u003c/code\u003e下载需要的镜像。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/569c7174b200474f9e20724d2f7c4e35_3621139936292873527.png\" title=\"下载镜像\" data-thumbnail=\"/569c7174b200474f9e20724d2f7c4e35_3621139936292873527.png\" data-sub-html=\"\u003ch2\u003e下载镜像\u003c/h2\u003e\u003cp\u003e下载镜像\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/569c7174b200474f9e20724d2f7c4e35_3621139936292873527.png srcset=\"/569c7174b200474f9e20724d2f7c4e35_3621139936292873527_hu9196916824288410992.webp 800w, /569c7174b200474f9e20724d2f7c4e35_3621139936292873527_hu7363381015228580235.webp 1200w, /569c7174b200474f9e20724d2f7c4e35_3621139936292873527_hu12805392114229377368.webp 1600w\"  alt=\"下载镜像\" height=\"366\" width=\"841\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e下载镜像\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"配置并启动容器\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e9%85%8d%e7%bd%ae%e5%b9%b6%e5%90%af%e5%8a%a8%e5%ae%b9%e5%99%a8\" class=\"header-mark\"\u003e\u003c/a\u003e3 配置并启动容器\u003c/h2\u003e\u003ch3 id=\"主机挂载目录\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%b8%bb%e6%9c%ba%e6%8c%82%e8%bd%bd%e7%9b%ae%e5%bd%95\" class=\"header-mark\"\u003e\u003c/a\u003e3.1 主机挂载目录\u003c/h3\u003e\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex