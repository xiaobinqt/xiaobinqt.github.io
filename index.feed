3cpath d=\"M16 132h416c8.837 0 16-7.163 16-16V76c0-8.837-7.163-16-16-16H16C7.163 60 0 67.163 0 76v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16zm0 160h416c8.837 0 16-7.163 16-16v-40c0-8.837-7.163-16-16-16H16c-8.837 0-16 7.163-16 16v40c0 8.837 7.163 16 16 16z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n      \n      \u003cbutton \n        class=\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-2\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003edocker run -d \\\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e--name kibana \\\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e-e ELASTICSEARCH_HOSTS=http://172.27.46.132:9200 \\\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e-p 5601:5601  \\\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003ekibana:7.12.1\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e命令说明：\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ccode\u003e-e ELASTICSEARCH_HOSTS=http://172.27.46.132:9200\u0026quot;\u003c/code\u003e：设置 \u003ccode\u003eelasticsearch\u003c/code\u003e 的地址，因为 \u003ccode\u003ekibana\u003c/code\u003e 已经与\u003ccode\u003eelasticsearch\u003c/code\u003e在一个网络，因此可以用容器名直接访问 \u003ccode\u003eelasticsearch\u003c/code\u003e，也可以写 IP 地址实现访问。\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003e-p 5601:5601\u003c/code\u003e：端口映射配置\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e安装的时候如果没有镜像，会下载镜像，效果如下：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/8348436b33284bba88bb2efa43b298f1_17199339649296732392.png\" title=\"\" data-thumbnail=\"/8348436b33284bba88bb2efa43b298f1_17199339649296732392.png\" data-sub-html=\"\u003ch2\u003e安装 Kibana\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/8348436b33284bba88bb2efa43b298f1_17199339649296732392.png srcset=\"/8348436b33284bba88bb2efa43b298f1_17199339649296732392_hu14774584497838288134.webp 800w, /8348436b33284bba88bb2efa43b298f1_17199339649296732392_hu7431965557074038077.webp 1200w, /8348436b33284bba88bb2efa43b298f1_17199339649296732392_hu14713617404450783749.webp 1600w\"   height=\"175\" width=\"632\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e安装 Kibana\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e安装成功后，可以访问 \u003ccode\u003ehttp://172.27.46.132:5601/\u003c/code\u003e 效果如下：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/53c75f9beec0482ba216e08af2e4d035_4798147386982601583.png\" title=\"\" data-thumbnail=\"/53c75f9beec0482ba216e08af2e4d035_4798147386982601583.png\" data-sub-html=\"\u003ch2\u003eKibana 效果\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/53c75f9beec0482ba216e08af2e4d035_4798147386982601583.png srcset=\"/53c75f9beec0482ba216e08af2e4d035_4798147386982601583_hu16805502114611279137.webp 800w, /53c75f9beec0482ba216e08af2e4d035_4798147386982601583_hu17058184236325154541.webp 1200w, /53c75f9beec0482ba216e08af2e4d035_4798147386982601583_hu1377156692098403938.webp 1600w\"   height=\"799\" width=\"1244\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eKibana 效果\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e可以点击 \u003ccode\u003eAdd data\u003c/code\u003e，添加示例数据，如下图，随意选一个即可，不选其实也是可以的。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/f74d72b57b544c6485d15de34417f89f_13526834783892560966.png\" title=\"\" data-thumbnail=\"/f74d72b57b544c6485d15de34417f89f_13526834783892560966.png\" data-sub-html=\"\u003ch2\u003e添加数据\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/f74d72b57b544c6485d15de34417f89f_13526834783892560966.png srcset=\"/f74d72b57b544c6485d15de34417f89f_13526834783892560966_hu9708874816716440317.webp 800w, /f74d72b57b544c6485d15de34417f89f_13526834783892560966_hu5964857882071689246.webp 1200w, /f74d72b57b544c6485d15de34417f89f_13526834783892560966_hu4604321817080853399.webp 1600w\"   height=\"772\" width=\"1605\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e添加数据\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"kibana-中文配置\" class=\"headerLink\"\u003e\n    \u003ca href=\"#kibana-%e4%b8%ad%e6%96%87%e9%85%8d%e7%bd%ae\" class=\"header-mark\"\u003e\u003c/a\u003e2.2 Kibana 中文配置\u003c/h3\u003e\u003cp\u003e\u003ccode\u003eKibana\u003c/code\u003e 支持中文配置，可以把 \u003ccode\u003eKibana\u003c/code\u003e 配置成中文版，切换中文操作如下:\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003etext\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.73c10.33 0 15.94 2.44 15