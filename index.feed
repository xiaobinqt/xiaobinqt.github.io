\"\n          copy-code-button\n          tw-select-none\n          tw-mx-2 \n          tw-hidden\n          group-[.is-open]:tw-block\n          hover:tw-text-fgColor-link \n          print:!tw-hidden\"\n        title=\"Copy code\"\u003e\n          \u003cspan class=\"copy-icon tw-block\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-3\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003egit checkout -b dev_xiaobinqt upstream/main\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/cb13278fb56c4a048cd816462159673a_8159098941704255549.png\" title=\"创建 dev_xiaobinqt 分支\" data-thumbnail=\"/cb13278fb56c4a048cd816462159673a_8159098941704255549.png\" data-sub-html=\"\u003ch2\u003e创建 dev_xiaobinqt 分支\u003c/h2\u003e\u003cp\u003e创建 dev_xiaobinqt 分支\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/cb13278fb56c4a048cd816462159673a_8159098941704255549.png srcset=\"/cb13278fb56c4a048cd816462159673a_8159098941704255549_hu13341293921987626392.webp 800w, /cb13278fb56c4a048cd816462159673a_8159098941704255549_hu9458637333867278333.webp 1200w, /cb13278fb56c4a048cd816462159673a_8159098941704255549_hu9185630807221853526.webp 1600w\"  alt=\"创建 dev_xiaobinqt 分支\" height=\"211\" width=\"924\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e创建 dev_xiaobinqt 分支\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e新建新文件 xiaobinqt.txt 并提交\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/d35eca199f72453f9ed972e75de3a91b_11135470378503751034.png\" title=\"新建文件并提交\" data-thumbnail=\"/d35eca199f72453f9ed972e75de3a91b_11135470378503751034.png\" data-sub-html=\"\u003ch2\u003e新建文件并提交\u003c/h2\u003e\u003cp\u003e新建文件并提交\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/d35eca199f72453f9ed972e75de3a91b_11135470378503751034.png srcset=\"/d35eca199f72453f9ed972e75de3a91b_11135470378503751034_hu8249348345069830880.webp 800w, /d35eca199f72453f9ed972e75de3a91b_11135470378503751034_hu6842605407488483100.webp 1200w, /d35eca199f72453f9ed972e75de3a91b_11135470378503751034_hu370607474241812630.webp 1600w\"  alt=\"新建文件并提交\" height=\"794\" width=\"854\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e新建文件并提交\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003epush 成功后再 github 项目下可以看到成功提示\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/c14f7b141e2e4b61885c90894a5b0e2d_11632439155325898276.png\" title=\"push 成功提示\" data-thumbnail=\"/c14f7b141e2e4b61885c90894a5b0e2d_11632439155325898276.png\" data-sub-html=\"\u003ch2\u003epush 成功提示\u003c/h2\u003e\u003cp\u003epush 成功提示\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/c14f7b141e2e4b61885c90894a5b0e2d_11632439155325898276.png srcset=\"/c14f7b141e2e4b61885c90894a5b0e2d_11632439155325898276_hu10964618107287779430.webp 800w, /c14f7b141e2e4b61885c90894a5b0e2d_11632439155325898276_hu10081508133322422756.webp 1200w, /c14f7b141e2e4b61885c90894a5b0e2d_11632439155325898276_hu4269631411819057911.webp 1600w\"  alt=\"push 成功提示\" height=\"420\" width=\"1440\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003epush 成功提示\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"新建-pr\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%96%b0%e5%bb%ba-pr\" class=\"header-mark\"\u003e\u003c/a\u003e4.4 新建 PR\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/14eee66c4908418ca52fc44d04739bab_106646965234383553.png\" title=\"new pull request\" data-thumbnail=\"/14eee66c4908418ca52fc44d04739bab_106646965234383553.png\" data-sub-html=\"\u003ch2\u003enew pull request\u003c/h2\u003e\u003cp\u003enew pull request\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/14eee66c4908418ca52fc44d04739bab_106646965234383553.png srcset=\"/14eee66c4908418ca52fc44d04739bab_106646965234383553_hu4813495833821977956.webp 800w, /14eee66c4908418ca52fc44d04739bab_106646965234383553_hu6305462844271817603.webp 1200w, /14eee66c4908418ca52fc44d04739bab_106646965234383553_hu4409203305923706498.webp 1600w\"  alt=\"new pull request\" height=\"400\" width=\"1628\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003enew pull request\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e选择要合并的分支并创建 pull request，这里我们将 \u003ccode\u003exiabinqt/git-dev\u003c/code\u003e 下面的 \u003ccode\u003edev_xiaobinqt\u003c/code\u003e 分支里的代码合并到 \u003ccode\u003exiao1996cc/git-dev\u003c/code\u003e 下的 \u003ccode\u003emain\u003c/code\u003e 分支。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/1baa99b602894dbb92024f578aadaaaf_4083480980696261768.png\" title=\"创建 pull request\" data-thumbnail=\"/1baa99b602894dbb92024f578aadaaaf_4083480980696261768.png\" data-sub-html=\"\u003ch2\u003e创建 pull request\u003c/h2\u003e\u003cp\u003e创建 pull request\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/1baa99b602894dbb92024f578aadaaaf_4083480980696261768.png srcset=\"/1baa99b602894dbb92024f578aadaaaf_4083480980696261768_hu18343078959529527149.webp 800w, /1baa99b602894dbb92024f578aadaaaf_4083480980696261768_hu12723271110962863190.webp 1200w, /1baa99b602894dbb92024f578aadaaaf_4083480980696261768_hu2563253426829233262.webp 1600w\"  alt=\"创建 pull request\" height=\"725\" width=\"1694\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e创建 pull request\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e2e612f093d94ac7a3989b01578351f6_5854528227160047035.png\" title=\"创建 pull request 成功\" data-thumbnail=\"/e2e612f093d94ac7a3989b01578351f6_5854528227160047035.png\" data-sub-html=\"\u003ch2\u003e创建 pull request 成功\u003c/h2\u003e\u003cp\u003e创建 pull request 成功\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e2e612f093d94ac7a3989b01578351f6_5854528227160047035.png srcset=\"/e2e612f093d94ac7a3989b01578351f6_5854528227160047035_hu9608493375601884465.webp 800w, /e2e612f093d94ac7a3989b01578351f6_5854528227160047035_hu13659017606064443716.webp 1200w, /e2e612f093d94ac7a3989b01578351f6_5854528227160047035_hu17542488581345742422.webp 1600w\"  alt=\"创建 pull request 成功\" height=\"844\" width=\"1485\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e创建 pull request 成功\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"合并-pr\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%90%88%e5%b9%b6-pr\" class=\"header-mark\"\u003e\u003c/a\u003e4.5 合并 PR\u003c/h3\u003e\u003cp\u003e\u003ccode\u003exiao1996cc/git-dev\u003c/code\u003e 项目下的 PR 只有\u003cstrong\u003e管理\u003c/strong\u003e这个项目的用户才有权限处理。管理员看到的界面是如下这样的：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/f3005f3c551c429eae96deb6c53e78dd_15137687174812999929.png\" title=\"管理者看到的 PR 界面\" data-thumbnail=\"/f3005f3c551c429eae96deb6c53e78dd_15137687174812999929.png\" data-sub-html=\"\u003ch2\u003e管理者看到的 PR 界面\u003c/h2\u003e\u003cp\u003e管理者看到的 PR 界面\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/f3005f3c551c429eae96deb6c53e78dd_15137687174812999929.png srcset=\"/f3005f3c551c429eae96deb6c53e78dd_15137687174812999929_hu15256778183245184807.webp 800w, /f3005f3c551c429eae96deb6c53e78dd_15137687174812999929_hu2406606992942584572.webp 1200w, /f3005f3c551c429eae96deb6c53e78dd_15137687174812999929_hu12286048170395526024.webp 1600w\"  alt=\"管理者看到的 PR 界面\" height=\"914\" width=\"1308\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e管理者看到的 PR 界面\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e处理完的 PR 状态会变成 Merged\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/b983d0f5d73a4a8e8a01a457df8fa584_16743080669392703835.png\" title=\"Merge PR\" data-thumbnail=\"/b983d0f5d73a4a8e8a01a457df8fa584_16743080669392703835.png\" data-sub-html=\"\u003ch2\u003eMerge PR\u003c/h2\u003e\u003cp\u003eMerge PR\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/b983d0f5d73a4a8e8a01a457df8fa584_16743080669392703835.png srcset=\"/b983d0f5d73a4a8e8a01a457df8fa584_16743080669392703835_hu6301841096415723956.webp 800w, /b983d0f5d73a4a8e8a01a457df8fa584_16743080669392703835_hu1100020648119626576.webp 1200w, /b983d0f5d73a4a8e8a01a457df8fa584_16743080669392703835_hu11554262945489297991.webp 1600w\"  alt=\"Merge PR\" height=\"643\" width=\"1258\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eMerge PR\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e至此 xiaobinqt 开发的一个功能已经成功提交到远程 upstream 仓库，也就是 \u003ccode\u003exiao1996cc/git-dev\u003c/code\u003e 仓库，虽然只新建了一个文件，但是一个完整的 pull request 流程。\u003c/p\u003e\n\u003ch2 id=\"lovenarcissus-开发新功能\" class=\"headerLink\"\u003e\n    \u003ca href=\"#lovenarcissus-%e5%bc%80%e5%8f%91%e6%96%b0%e5%8a%9f%e8%83%bd\" class=\"header-mark\"\u003e\u003c/a\u003e5 lovenarcissus 开发新功能\u003c/h2\u003e\u003cp\u003e对于 \u003ccode\u003elovenarcissus\u003c/code\u003e 开发者来说，也是先 fork 项目再 clone 项目到本地。\u003c/p\u003e\n\u003cp\u003e可以看到 \u003ccode\u003elovenarcissus\u003c/code\u003e fork 后的项目是有 xiaobinqt.txt 这个文件的，同时也验证了 xiaobinqt 开发者成功向远程仓库提交了代码。这里默认已经 clone 到了本地仓库。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/91c9b6dd2c614ff28d7d73751bbe59b8_7223785182149321393.png\" title=\"lovenarcissus fork\" data-thumbnail=\"/91c9b6dd2c614ff28d7d73751bbe59b8_7223785182149321393.png\" data-sub-html=\"\u003ch2\u003elovenarcissus fork\u003c/h2\u003e\u003cp\u003elovenarcissus fork\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/91c9b6dd2c614ff28d7d73751bbe59b8_7223785182149321393.png srcset=\"/91c9b6dd2c614ff28d7d73751bbe59b8_7223785182149321393_hu14326387330224369280.webp 800w, /91c9b6dd2c614ff28d7d73751bbe59b8_7223785182149321393_hu11096729168823694263.webp 1200w, /91c9b6dd2c614ff28d7d73751bbe59b8_7223785182149321393_hu5011221240829660965.webp 1600w\"  alt=\"lovenarcissus fork\" height=\"601\" width=\"1765\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003elovenarcissus fork\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"添加远程仓库-1\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%b7%bb%e5%8a%a0%e8%bf%9c%e7%a8%8b%e4%bb%93%e5%ba%93-1\" class=\"header-mark\"\u003e\u003c/a\u003e5.1 添加远程仓库\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/4ca1d947307d4ec58848a23eb5bc73fc_16272896752751234963.png\" title=\"添加远程仓库\" data-thumbnail=\"/4ca1d947307d4ec58848a23eb5bc73fc_16272896752751234963.png\" data-sub-html=\"\u003ch2\u003e添加远程仓库\u003c/h2\u003e\u003cp\u003e添加远程仓库\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/4ca1d947307d4ec58848a23eb5bc73fc_16272896752751234963.png srcset=\"/4ca1d947307d4ec58848a23eb5bc73fc_16272896752751234963_hu17412266945319567414.webp 800w, /4ca1d947307d4ec58848a23eb5bc73fc_16272896752751234963_hu4464561726198767985.webp 1200w, /4ca1d947307d4ec58848a23eb5bc73fc_16272896752751234963_hu15350527716262696452.webp 1600w\"  alt=\"添加远程仓库\" height=\"711\" width=\"1241\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e添加远程仓库\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003efetch 远程仓库代码\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/2f039b5452514811a89853710843a6a0_13077979331682534814.png\" title=\"git fetch upsteam\" data-thumbnail=\"/2f039b5452514811a89853710843a6a0_13077979331682534814.png\" data-sub-html=\"\u003ch2\u003egit fetch upsteam\u003c/h2\u003e\u003cp\u003egit fetch upsteam\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/2f039b5452514811a89853710843a6a0_13077979331682534814.png srcset=\"/2f039b5452514811a89853710843a6a0_13077979331682534814_hu6061098883934284347.webp 800w, /2f039b5452514811a89853710843a6a0_13077979331682534814_hu7313926512643749698.webp 1200w, /2f039b5452514811a89853710843a6a0_13077979331682534814_hu11141451986783002020.webp 1600w\"  alt=\"git fetch upsteam\" height=\"173\" width=\"768\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003egit fetch upsteam\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"新建分支并开发-1\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%96%b0%e5%bb%ba%e5%88%86%e6%94%af%e5%b9%b6%e5%bc%80%e5%8f%91-1\" class=\"header-mark\"\u003e\u003c/a\u003e5.2 新建分支并开发\u003c/h3\u003e\u003cp\u003e基于 \u003ccode\u003eupstream/main\u003c/code\u003e 创建新分支 \u003ccode\u003edev_lovenarcissus\u003c/code\u003e 开发分支\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font