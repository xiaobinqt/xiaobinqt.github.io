ewBox=\"0 0 448 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-4\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003egit checkout -b dev_lovenarcissus upstream/main\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/64abb29d6e604f84b732c055a9359372_13228362819199658875.png\" title=\"新建开发分支\" data-thumbnail=\"/64abb29d6e604f84b732c055a9359372_13228362819199658875.png\" data-sub-html=\"\u003ch2\u003e新建开发分支\u003c/h2\u003e\u003cp\u003e新建开发分支\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/64abb29d6e604f84b732c055a9359372_13228362819199658875.png srcset=\"/64abb29d6e604f84b732c055a9359372_13228362819199658875_hu8614240563308246440.webp 800w, /64abb29d6e604f84b732c055a9359372_13228362819199658875_hu6848418910908112871.webp 1200w, /64abb29d6e604f84b732c055a9359372_13228362819199658875_hu3023960645522008531.webp 1600w\"  alt=\"新建开发分支\" height=\"149\" width=\"912\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e新建开发分支\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e新建 lovenarcissus.txt 文件并修改 xiaobinqt.txt 文件\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/7af1393f145b4837b651c45c6c67167b_14127005467294074793.png\" title=\"开发代码\" data-thumbnail=\"/7af1393f145b4837b651c45c6c67167b_14127005467294074793.png\" data-sub-html=\"\u003ch2\u003e开发代码\u003c/h2\u003e\u003cp\u003e开发代码\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/7af1393f145b4837b651c45c6c67167b_14127005467294074793.png srcset=\"/7af1393f145b4837b651c45c6c67167b_14127005467294074793_hu11996291743431380444.webp 800w, /7af1393f145b4837b651c45c6c67167b_14127005467294074793_hu1652355792964460750.webp 1200w, /7af1393f145b4837b651c45c6c67167b_14127005467294074793_hu3786510886949713549.webp 1600w\"  alt=\"开发代码\" height=\"352\" width=\"899\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e开发代码\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e提交代码\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/d748706fc84d4874bb3f548b9b770deb_17622711302707934245.png\" title=\"提交代码\" data-thumbnail=\"/d748706fc84d4874bb3f548b9b770deb_17622711302707934245.png\" data-sub-html=\"\u003ch2\u003e提交代码\u003c/h2\u003e\u003cp\u003e提交代码\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/d748706fc84d4874bb3f548b9b770deb_17622711302707934245.png srcset=\"/d748706fc84d4874bb3f548b9b770deb_17622711302707934245_hu6486201721072170815.webp 800w, /d748706fc84d4874bb3f548b9b770deb_17622711302707934245_hu17954826983379576950.webp 1200w, /d748706fc84d4874bb3f548b9b770deb_17622711302707934245_hu6734230247702306420.webp 1600w\"  alt=\"提交代码\" height=\"650\" width=\"1092\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e提交代码\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"新建-pr-1\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%96%b0%e5%bb%ba-pr-1\" class=\"header-mark\"\u003e\u003c/a\u003e5.3 新建 PR\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/ae6ab7174cc74c58b02216267b2bfb06_13438786259111910310.png\" title=\"新建 pull request\" data-thumbnail=\"/ae6ab7174cc74c58b02216267b2bfb06_13438786259111910310.png\" data-sub-html=\"\u003ch2\u003e新建 pull request\u003c/h2\u003e\u003cp\u003e新建 pull request\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/ae6ab7174cc74c58b02216267b2bfb06_13438786259111910310.png srcset=\"/ae6ab7174cc74c58b02216267b2bfb06_13438786259111910310_hu9307653576242615746.webp 800w, /ae6ab7174cc74c58b02216267b2bfb06_13438786259111910310_hu12090890468335402601.webp 1200w, /ae6ab7174cc74c58b02216267b2bfb06_13438786259111910310_hu3708552075862707251.webp 1600w\"  alt=\"新建 pull request\" height=\"686\" width=\"1582\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e新建 pull request\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"合并-pr-1\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%90%88%e5%b9%b6-pr-1\" class=\"header-mark\"\u003e\u003c/a\u003e5.4 合并 PR\u003c/h3\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/617fd9602dec47e39f6e69ce57138bee_15005817317588851660.png\" title=\"Merge pull request\" data-thumbnail=\"/617fd9602dec47e39f6e69ce57138bee_15005817317588851660.png\" data-sub-html=\"\u003ch2\u003eMerge pull request\u003c/h2\u003e\u003cp\u003eMerge pull request\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/617fd9602dec47e39f6e69ce57138bee_15005817317588851660.png srcset=\"/617fd9602dec47e39f6e69ce57138bee_15005817317588851660_hu5149440874119592545.webp 800w, /617fd9602dec47e39f6e69ce57138bee_15005817317588851660_hu16395354931072167535.webp 1200w, /617fd9602dec47e39f6e69ce57138bee_15005817317588851660_hu3386624365659013144.webp 1600w\"  alt=\"Merge pull request\" height=\"616\" width=\"1438\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eMerge pull request\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"模拟并解决冲突\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e6%a8%a1%e6%8b%9f%e5%b9%b6%e8%a7%a3%e5%86%b3%e5%86%b2%e7%aa%81\" class=\"header-mark\"\u003e\u003c/a\u003e6 模拟并解决冲突\u003c/h2\u003e\u003ch3 id=\"出现冲突\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%87%ba%e7%8e%b0%e5%86%b2%e7%aa%81\" class=\"header-mark\"\u003e\u003c/a\u003e6.1 出现冲突\u003c/h3\u003e\u003cp\u003e现在开发者 xiaobinqt 和开发者 lovenarcissus 都提了代码到远程仓库 \u003ccode\u003exiao1996cc/git-dev\u003c/code\u003e，仓库里文件如下：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/ab47d38c6f544048a2e39a8f5c90314b_15368708764533657609.png\" title=\"远程代码仓库\" data-thumbnail=\"/ab47d38c6f544048a2e39a8f5c90314b_15368708764533657609.png\" data-sub-html=\"\u003ch2\u003e远程代码仓库\u003c/h2\u003e\u003cp\u003e远程代码仓库\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/ab47d38c6f544048a2e39a8f5c90314b_15368708764533657609.png srcset=\"/ab47d38c6f544048a2e39a8f5c90314b_15368708764533657609_hu370824830675374019.webp 800w, /ab47d38c6f544048a2e39a8f5c90314b_15368708764533657609_hu14169695777874975017.webp 1200w, /ab47d38c6f544048a2e39a8f5c90314b_15368708764533657609_hu2520233087799097033.webp 1600w\"  alt=\"远程代码仓库\" height=\"368\" width=\"1326\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e远程代码仓库\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e现在开发者 xiaobinqt 需要开发一个新的功能，新增一个 xiaobinqt2.txt 文件，并且修改 xiaobinqt.txt 文件，但是这时 xiaobinqt 并没有 fetch 合并远程仓库的代码，xiaobinqt 本地仓库文件如下：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/cd94ad34b4e4464598c6ec6726baec10_2333523943677445349.png\" title=\"文件列表\" data-thumbnail=\"/cd94ad34b4e4464598c6ec6726baec10_2333523943677445349.png\" data-sub-html=\"\u003ch2\u003e文件列表\u003c/h2\u003e\u003cp\u003e文件列表\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/cd94ad34b4e4464598c6ec6726baec10_2333523943677445349.png srcset=\"/cd94ad34b4e4464598c6ec6726baec10_2333523943677445349_hu4677659561593454542.webp 800w, /cd94ad34b4e4464598c6ec6726baec10_2333523943677445349_hu5376265859453882348.webp 1200w, /cd94ad34b4e4464598c6ec6726baec10_2333523943677445349_hu17884610997194022265.webp 1600w\"  alt=\"文件列表\" height=\"203\" width=\"733\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e文件列表\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e直接新建 xiaobinqt2.txt 文件，并且修改 xiaobinqt.txt 文件\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/1faab506c99d4ca2ba4781fed2ae64bd_7811436475996912840.png\" title=\"新建并修改文件\" data-thumbnail=\"/1faab506c99d4ca2ba4781fed2ae64bd_7811436475996912840.png\" data-sub-html=\"\u003ch2\u003e新建并修改文件\u003c/h2\u003e\u003cp\u003e新建并修改文件\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/1faab506c99d4ca2ba4781fed2ae64bd_7811436475996912840.png srcset=\"/1faab506c99d4ca2ba4781fed2ae64bd_7811436475996912840_hu6346294560424102423.webp 800w, /1faab506c99d4ca2ba4781fed2ae64bd_7811436475996912840_hu6651845932476242319.webp 1200w, /1faab506c99d4ca2ba4781fed2ae64bd_7811436475996912840_hu75672771717653057.webp 1600w\"  alt=\"新建并修改文件\" height=\"410\" width=\"726\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e新建并修改文件\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003epush 代码到远程仓库，并创建 pull request\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/dc48fe23f17d424a93bd817868996c3c_8298159795698862318.png\" title=\"push 代码\" data-thumbnail=\"/dc48fe23f17d424a93bd817868996c3c_8298159795698862318.png\" data-sub-html=\"\u003ch2\u003epush 代码\u003c/h2\u003e\u003cp\u003epush 代码\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/dc48fe23f17d424a93bd817868996c3c_8298159795698862318.png srcset=\"/dc48fe23f17d424a93bd817868996c3c_8298159795698862318_hu6140637996073271077.webp 800w, /dc48fe23f17d424a93bd817868996c3c_8298159795698862318_hu12950825716624261307.webp 1200w, /dc48fe23f17d424a93bd817868996c3c_8298159795698862318_hu7035127084766047362.webp 1600w\"  alt=\"push 代码\" height=\"532\" width=\"881\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003epush 代码\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e可以看到在创建 pull request 时出现了冲突，提示 \u003cstrong\u003eCan’t automatically merge\u003c/strong\u003e ，\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/d3a54feea2844ffe82712751186a651a_16647179942538144199.png\" title=\"PR 出现冲突\" data-thumbnail=\"/d3a54feea2844ffe82712751186a651a_16647179942538144199.png\" data-sub-html=\"\u003ch2\u003ePR 出现冲突\u003c/h2\u003e\u003cp\u003ePR 出现冲突\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/d3a54feea2844ffe82712751186a651a_16647179942538144199.png srcset=\"/d3a54feea2844ffe82712751186a651a_16647179942538144199_hu8237636441360299478.webp 800w, /d3a54feea2844ffe82712751186a651a_16647179942538144199_hu8816326356872870425.webp 1200w, /d3a54feea2844ffe82712751186a651a_16647179942538144199_hu9869936724351084443.webp 1600w\"  alt=\"PR 出现冲突\" height=\"869\" width=\"1672\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003ePR 出现冲突\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"解决冲突\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e8%a7%a3%e5%86%b3%e5%86%b2%e7%aa%81\" class=\"header-mark\"\u003e\u003c/a\u003e6.2 解决冲突\u003c/h3\u003e\u003cp\u003e出现冲突的原因是本地代码跟 origin 仓库的代码是一样的，但是 origin 仓库跟 upstream 仓库代码不一致。我们需要先 fetch 下 upstream 仓库的代码跟本地代码合并后再 push 到 origin 仓库，再从 origin 仓库提 pull request 到 upsteam 仓库。\u003c/p\u003e\n\u003cp\u003e由\u0026#x1f447;图可知，在 merge upstream/main 分支时出现了冲突 \u003ccode\u003eAutomatic merge failed; fix conflicts and then commit the result.\u003c/code\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/40dd7bedf7c041d1859fb76c0cc3a2b7_15605851313907355303.png\" title=\"merge conflicts\" data-thumbnail=\"/40dd7bedf7c041d1859fb76c0cc3a2b7_15605851313907355303.png\" data-sub-html=\"\u003ch2\u003emerge conflicts\u003c/h2\u003e\u003cp\u003emerge conflicts\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/40dd7bedf7c041d1859fb76c0cc3a2b7_15605851313907355303.png srcset=\"/40dd7bedf7c041d1859fb76c0cc3a2b7_15605851313907355303_hu14725521708651934269.webp 800w, /40dd7bedf7c041d1859fb76c0cc3a2b7_15605851313907355303_hu9105336893858563840.webp 1200w, /40dd7bedf7c041d1859fb76c0cc3a2b7_15605851313907355303_hu1255760409966838694.webp 1600w\"  alt=\"merge conflicts\" height=\"388\" width=\"736\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003emerge conflicts\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003evim 打开冲突文件 xiaobinqt.txt 解决冲突\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/be7281a78f814a13b97c50fb8a643bbd_6936491185833652927.png\" title=\"冲突文件内容\" data-thumbnail=\"/be7281a78f814a13b97c50fb8a643bbd_6936491185833652927.png\" data-sub-html=\"\u003ch2\u003e冲突文件内容\u003c/h2\u003e\u003cp\u003e冲突文件内容\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/be7281a78f814a13b97c50fb8a643bbd_6936491185833652927.png srcset=\"/be7281a78f814a13b97c50fb8a643bbd_6936491185833652927_hu4471864989253880205.webp 800w, /be7281a78f814a13b97c50fb8a643bbd_6936491185833652927_hu1753920335997488292.webp 1200w, /be7281a78f814a13b97c50fb8a643bbd_6936491185833652927_hu12045614041030224506.webp 1600w\"  alt=\"冲突文件内容\" height=\"150\" width=\"352\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e冲突文件内容\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e解决冲突后的文件 \u0026#x1f447;\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e5f0185bb84548a98ad33d1a23d7f5c2_3990969901090178459.png\" title=\"解决冲突后的文件\" data-thumbnail=\"/e5f0185bb84548a98ad33d1a23d7f5c2_3990969901090178459.png\" data-sub-html=\"\u003ch2\u003e解决冲突后的文件\u003c/h2\u003e\u003cp\u003e解决冲突后的文件\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e5f0185bb84548a98ad33d1a23d7f5c2_3990969901090178459.png srcset=\"/e5f0185bb84548a98ad33d1a23d7f5c2_3990969901090178459_hu15102214697253499802.webp 800w, /e5f0185bb84548a98ad33d1a23d7f5c2_3990969901090178459_hu8239848967142209193.webp 1200w, /e5f0185bb84548a98ad33d1a23d7f5c2_3990969901090178459_hu805065727497137338.webp 1600w\"  alt=\"解决冲突后的文件\" height=\"102\" width=\"425\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e解决冲突后的文件\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e以下\u0026#x1f447;是解决这次冲突的具体步骤：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/f54a92110ac345c68c327ed16f6aea47_9225055976362392045.png\" title=\"解决冲突具体步骤\" data-thumbnail=\"/f54a92110ac345c68c327ed16f6aea47_9225055976362392045.png\" data-sub-html=\"\u003ch2\u003e解决冲突具体步骤\u003c/h2\u003e\u003cp\u003e解决冲突具体步骤\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/f54a92110ac345c68c327ed16f6aea47_9225055976362392045.png srcset=\"/f54a92110ac345c68c327ed16f6aea47_9225055976362392045_hu13748822301688187955.webp 800w, /f54a92110ac345c68c327ed16f6aea47_9225055976362392045_hu14250965447211761510.webp 1200w, /f54a92110ac345c68c327ed16f6aea47_9225055976362392045_hu6946226816787394054.webp 1600w\"  alt=\"解决冲突具体步骤\" height=\"1022\" width=\"776\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e解决冲突具体步骤\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch3 id=\"重提-pr\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e9%87%8d%e6%8f%90-pr\" class=\"header-mark\"\u003e\u003c/a\u003e6.3 重提 PR\u003c/h3\u003e\u003cp\u003e这时对于 xiaobinqt 开发者来说，冲突已经解决，可以重新提 pull request \u0026#x1f447;，可以看到现在的状态是 \u003cstrong\u003eAble to merge.\u003c/strong\u003e。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/df8451a7d11f4799a3ed00a36ffe37bb_16595408204895655121.png\" title=\"重提 PR\" data-thumbnail=\"/df8451a7d11f4799a3ed00a36ffe37bb_16595408204895655121.png\" data-sub-html=\"\u003ch2\u003e重提 PR\u003c/h2\u003e\u003cp\u003e重提 PR\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/df8451a7d11f4799a3ed00a36ffe37bb_16595408204895655121.png srcset=\"/df8451a7d11f4799a3ed00a36ffe37bb_16595408204895655121_hu10493762367539396838.webp 800w, /df8451a7d11f4799a3ed00a36ffe37bb_16595408204895655121_hu15815084321154973926.webp 1200w, /df8451a7d11f4799a3ed00a36ffe37bb_16595408204895655121_hu7042819183433123292.webp 1600w\"  alt=\"重提 PR\" height=\"877\" width=\"1689\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e重提 PR\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e创建新的 pull request 成功\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/c061dcc8dc51406b8ec77431273ea5cd_15630864007352623641.png\" title=\"创建新的 PR 成功\" data-thumbnail=\"/c061dcc8dc51406b8ec77431273ea5cd_15630864007352623641.png\" data-sub-html=\"\u003ch2\u003e创建新的 PR 成功\u003c/h2\u003e\u003cp\u003e创建新的 PR 成功\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/c061dcc8dc51406b8ec77431273ea5cd_15630864007352623641.png srcset=\"/c061dcc8dc51406b8ec77431273ea5cd_15630864007352623641_hu4758386585977697713.webp 800w, /c061dcc8dc51406b8ec77431273ea5cd_15630864007352623641_hu1308345501450866062.webp 1200w, /c061dcc8dc51406b8ec77431273ea5cd_15630864007352623641_hu12877187445558019121.webp 1600w\"  alt=\"创建新的 PR 成功\" height=\"728\" width=\"1721\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e创建新的 PR 成功\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "Mongodb 学习笔记",
        "date_published" : "2021-04-14T00:00:00Z",
        "date_modified" : "2024-08-22T22:46:57+08:00",
        "id" : "https://www.xiaobinqt.cn/mongodb-glance/",
        "url" : "https://www.xiaobinqt.cn/mongodb-glance/",
        "summary": " 1 安装 1.1 win10 安装在 windows 下安装可以参考这篇文章mongodb-window-install。\n1.1.1 小坑我使用的是 windows 10 企业版，在安装时出现了个问题，如下：\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003ch2 id=\"安装\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%ae%89%e8%a3%85\" class=\"header-mark\"\u003e\u003c/a\u003e1 安装\u003c/h2\u003e\u003ch3 id=\"win10-安装\" class=\"headerLink\"\u003e\n    \u003ca href=\"#win10-%e5%ae%89%e8%a3%85\" class=\"header-mark\"\u003e\u003c/a\u003e1.1 win10 安装\u003c/h3\u003e\u003cp\u003e在 windows 下安装可以参考这篇文章\u003ca href=\"https://www.runoob.com/mongodb/mongodb-window-install.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003emongodb-window-install\u003c/a\u003e。\u003c/p\u003e\n\u003ch4 id=\"小坑\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%b0%8f%e5%9d%91\" class=\"header-mark\"\u003e\u003c/a\u003e1.1.1 小坑\u003c/h4\u003e\u003cp\u003e我使用的是 windows 10 企业版，在安装时出现了个问题，如下：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/e5f7304f5527496590e80849459354ac_5751741162180323008.png\" title=\"问题截图\" data-thumbnail=\"/e5f7304f5527496590e80849459354ac_5751741162180323008.png\" data-sub-html=\"\u003ch2\u003e问题截图\u003c/h2\u003e\u003cp\u003e问题截图\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/e5f7304f5527496590e80849459354ac_5751741162180323008.png srcset=\"/e5f7304f5527496590e80849459354ac_5751741162180323008_hu348773450919712919.webp 800w, /e5f7304f5527496590e80849459354ac_5751741162180323008_hu3758588807992839209.webp 1200w, /e5f7304f5527496590e80849459354ac_5751741162180323008_hu17534071873920157524.webp 1600w\"  alt=\"问题截图\" height=\"428\" width=\"585\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e问题截图\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e我是在网上找了大半天没有找到解决的办法，都是写文章作者可用，但是我一直不生效，我觉得的必须要用管理员权限安装导致的。后来我直接忽略了，用管理员权限运行。\u003c/p\u003e\n\u003ch4 id=\"运行服务端\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e8%bf%90%e8%a1%8c%e6%9c%8d%e5%8a%a1%e7%ab%af\" class=\"header-mark\"\u003e\u003c/a\u003e1.1.2 运行服务端\u003c/h4\u003e\u003cp\u003e用管理员 power shell 运行 具体命令可以参看\u003ca href=\"https://www.runoob.com/mongodb/mongodb-window-install.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e文档\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/729bcbd9bd9845a09340ed05d4518c9b_12244721373448639528.png\" title=\"运行 mongodb 服务 01\" data-thumbnail=\"/729bcbd9bd9845a09340ed05d4518c9b_12244721373448639528.png\" data-sub-html=\"\u003ch2\u003e运行 mongodb 服务 01\u003c/h2\u003e\u003cp\u003e运行 mongodb 服务 01\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/729bcbd9bd9845a09340ed05d4518c9b_12244721373448639528.png srcset=\"/729bcbd9bd9845a09340ed05d4518c9b_12244721373448639528_hu32715576077801103.webp 800w, /729bcbd9bd9845a09340ed05d4518c9b_12244721373448639528_hu12157720397602046166.webp 1200w, /729bcbd9bd9845a09340ed05d4518c9b_12244721373448639528_hu3351099578577448785.webp 1600w\"  alt=\"运行 mongodb 服务 01\" height=\"350\" width=\"529\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e运行 mongodb 服务 01\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 2