 Code: MIT License) --\u003e\u003cpath d=\"M433.941 65.941l-51.882-51.882A48 48 0 0 0 348.118 0H176c-26.51 0-48 21.49-48 48v48H48c-26.51 0-48 21.49-48 48v320c0 26.51 21.49 48 48 48h224c26.51 0 48-21.49 48-48v-48h80c26.51 0 48-21.49 48-48V99.882a48 48 0 0 0-14.059-33.941zM266 464H54a6 6 0 0 1-6-6V150a6 6 0 0 1 6-6h74v224c0 26.51 21.49 48 48 48h96v42a6 6 0 0 1-6 6zm128-96H182a6 6 0 0 1-6-6V54a6 6 0 0 1 6-6h106v88c0 13.255 10.745 24 24 24h88v202a6 6 0 0 1-6 6zm6-256h-64V48h9.632c1.591 0 3.117.632 4.243 1.757l48.368 48.368a6 6 0 0 1 1.757 4.243V112z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n          \u003cspan class=\"check-icon tw-hidden\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-2\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eWarning: Permanently added \u003cspan class=\"s1\"\u003e\u0026#39;192.168.40.233\u0026#39;\u003c/span\u003e \u003cspan class=\"o\"\u003e(\u003c/span\u003eECDSA\u003cspan class=\"o\"\u003e)\u003c/span\u003e to the list of known hosts.\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e@         WARNING: UNPROTECTED PRIVATE KEY FILE!          @\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@@\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003ePermissions \u003cspan class=\"m\"\u003e0755\u003c/span\u003e \u003cspan class=\"k\"\u003efor\u003c/span\u003e \u003cspan class=\"s1\"\u003e\u0026#39;/tmp/tmp.LGAlGyMvNs/id_rsa\u0026#39;\u003c/span\u003e are too open.\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eIt is required that your private key files are NOT accessible by others.\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eThis private key will be ignored.\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eLoad key \u003cspan class=\"s2\"\u003e\u0026#34;/tmp/tmp.LGAlGyMvNs/id_rsa\u0026#34;\u003c/span\u003e: bad permissions\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003ePermission denied \u003cspan class=\"o\"\u003e(\u003c/span\u003epublickey\u003cspan class=\"o\"\u003e)\u003c/span\u003e.\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e致命错误：无法读取远程仓库。\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003e请确认您有正确的访问权限并且仓库存在。\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e我根据\u003ccode\u003ePermissions 0755 for '/tmp/tmp.LGAlGyMvNs/id_rsa' are too open.\u003c/code\u003e google 了下，原来是 isa 文件权限给的太高了，改成 400 或是 600 就可以了。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/283ea804c9de4b1dbe456b4e8915182f_15732790608081215118.png\" title=\"\" data-thumbnail=\"/283ea804c9de4b1dbe456b4e8915182f_15732790608081215118.png\" data-sub-html=\"\u003ch2\u003e问题解决\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/283ea804c9de4b1dbe456b4e8915182f_15732790608081215118.png srcset=\"/283ea804c9de4b1dbe456b4e8915182f_15732790608081215118_hu3583833257700520442.webp 800w, /283ea804c9de4b1dbe456b4e8915182f_15732790608081215118_hu4995436172721734466.webp 1200w, /283ea804c9de4b1dbe456b4e8915182f_15732790608081215118_hu7573804567384108431.webp 1600w\"   height=\"556\" width=\"1533\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e问题解决\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003ch2 id=\"参考\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%8f%82%e8%80%83\" class=\"header-mark\"\u003e\u003c/a\u003e2 参考\u003c/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://www.educative.io/answers/ssh-error-permissions-are-too-open\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eSSH error: permissions are too open\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://juejin.cn/post/7071910670056292389\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eCentOS 7 升级 git 版本到 2.x\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "Windows 10 专业版使用 WSL",
        "date_published" : "2023-02-22T00:00:00Z",
        "date_modified" : "2023-07-05T10:09:00+08:00",
        "id" : "https://www.xiaobinqt.cn/windows-wsl/",
        "url" : "https://www.xiaobinqt.cn/windows-wsl/",
        "summary": " 1 什么是 wslWindows Subsystem for Linux（WSL）是一个在 Windows 10+ 上能够运行原生 Linux 二进制可执行文件的兼容层。\n与 WSL1 相比，WSL 2 使用更新、更强大的虚拟化技术在轻量级实用工具虚拟机 (VM) 中运行 Linux 内核。\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003c!-- author： xiaobinqt --\u003e\n\u003c!-- email： xiaobinqt@163.com --\u003e\n\u003c!-- https://xiaobinqt.github.io --\u003e\n\u003c!-- https://www.xiaobinqt.cn --\u003e\n\u003ch2 id=\"什么是-wsl\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%bb%80%e4%b9%88%e6%98%af-wsl\" class=\"header-mark\"\u003e\u003c/a\u003e1 什么是 wsl\u003c/h2\u003e\u003cp\u003eWindows Subsystem for Linux（WSL）是一个在 Windows 10+ 上能够运行原生 Linux 二进制可执行文件的兼容层。\u003c/p\u003e\n\u003cp\u003e与 WSL1 相比，WSL 2 使用更新、更强大的虚拟化技术在轻量级实用工具虚拟机 (VM) 中运行 Linux 内核。\u003c/p\u003e\n\u003ch2 id=\"安装\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%ae%89%e8%a3%85\" class=\"header-mark\"\u003e\u003c/a\u003e2 安装\u003c/h2\u003e\u003cp\u003e我是 win10 专业版，其他版本的 win10 也类似，不过\u003cstrong\u003e推荐使用专业版\u003c/strong\u003e。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/a15dfa3e82854382859261a104cd8f3c_16781336353146478090.png\" title=\"\" data-thumbnail=\"/a15dfa3e82854382859261a104cd8f3c_16781336353146478090.png\" data-sub-html=\"\u003ch2\u003e电脑版本\u003c/h2\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/a15dfa3e82854382859261a104cd8f3c_16781336353146478090.png srcset=\"/a15dfa3e82854382859261a104cd8f3c_16781336353146478090_hu5656360501642143671.webp 800w, /a15dfa3e82854382859261a104cd8f3c_16781336353146478090_hu13574448230370055791.webp 1200w, /a15dfa3e82854382859261a104cd8f3c_16781336353146478090_hu641453630619524257.webp 1600w\"   height=\"103\" width=\"540\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e电脑版本\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e进入 windows 终端\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003ewsl -l -o\u003c/code\u003e查看可安装的发行版\u003c/li\u003e\n\u003cli\u003e执行\u003ccode\u003ewsl --set-default-version 2\u003c/code\u003e将 WSL 默认版本调整为 WSL2\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003ewsl --install --d NAME\u003c/code\u003e即可安装。如： \u003ccode\u003ewsl --install --d ubuntu-20.04\u003c/code\u003e可安装 ubuntu20.04\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003ewsl -l -v\u003c/code\u003e可查看安装的发行版的 WSL 版本\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e注销（卸载）当前安装的 Linux 的 Windows 子系统可以使用：\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003eshell\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 51