p;\u003c/span\u003e\u003cspan class=\"nv\"\u003eos_arch\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003ex86_64\u003cspan class=\"p\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"nv\"\u003enacl_arch\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003ex86-64\u003cspan class=\"p\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"nv\"\u003eprod\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003echromecrx\u003cspan class=\"p\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"nv\"\u003eprodchannel\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003e\u003cspan class=\"p\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"nv\"\u003eprodversion\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003e77.0.3865.90\u003cspan class=\"p\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"nv\"\u003elang\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003ezh-CN\u003cspan class=\"p\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"nv\"\u003eacceptformat\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003ecrx2,crx3\u003cspan class=\"p\"\u003e\u0026amp;\u003c/span\u003e\u003cspan class=\"nv\"\u003ex\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003eid%3D\u003cspan class=\"o\"\u003e{\u003c/span\u003eXXXX\u003cspan class=\"o\"\u003e}\u003c/span\u003e%26installsource%3Dondemand%26uc\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e将以上的 \u003ccode\u003e{XXXX}\u003c/code\u003e 替换为插件的 ID，就可以下载到本地了。\u003c/p\u003e\n\u003cp\u003e以下这个地址是\u003ccode\u003eMote：语音笔记和反馈\u003c/code\u003e插件的下载地址，成功下载的插件是 .crx 结尾的文件。直接拖到浏览器中就会自动安装。\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none