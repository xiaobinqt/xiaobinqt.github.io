T License) --\u003e\u003cpath d=\"M173.898 439.404l-166.4-166.4c-9.997-9.997-9.997-26.206 0-36.204l36.203-36.204c9.997-9.998 26.207-9.998 36.204 0L192 312.69 432.095 72.596c9.997-9.997 26.207-9.997 36.204 0l36.203 36.204c9.997 9.997 9.997 26.206 0 36.204l-294.4 294.401c-9.998 9.997-26.207 9.997-36.204-.001z\"/\u003e\u003c/svg\u003e\u003c/span\u003e\n      \u003c/button\u003e\n        \n      \u003cbutton \n        class=\"\n          tw-select-none \n          tw-mx-2 \n          tw-block \n          group-[.is-open]:tw-hidden \n          print:!tw-hidden\" \n        disabled\n        aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M328 256c0 39.8-32.2 72-72 72s-72-32.2-72-72 32.2-72 72-72 72 32.2 72 72zm104-72c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72zm-352 0c-39.8 0-72 32.2-72 72s32.2 72 72 72 72-32.2 72-72-32.2-72-72-72z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cpre style=\"counter-reset: codeblock;\" class=\"tw-block tw-m-0 tw-p-0\"\u003e\u003ccode \n    id=\"codeblock-id-16\" \n    class=\"\n      chroma \n      !tw-block \n      tw-p-0\n      tw-m-0\n      tw-transition-[max-height] \n      tw-duration-500 \n      tw-ease-in-out \n      group-[.is-closed]:!tw-max-h-0 \n      group-[.is-wrap]:tw-text-wrap\n      tw-overflow-y-hidden\n      tw-overflow-x-auto\n      tw-scrollbar-thin\n      \"\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eAccess-Control-Allow-Origin: http://api.bob.com\n\u003c/span\u003e\u003c/span\u003e\u003cspan class=\"line\"\u003e\u003cspan class=\"cl\"\u003eContent-Type: text/html\u003cspan class=\"p\"\u003e;\u003c/span\u003e \u003cspan class=\"nv\"\u003echarset\u003c/span\u003e\u003cspan class=\"o\"\u003e=\u003c/span\u003eutf-8\u003c/span\u003e\u003c/span\u003e\u003c/code\u003e\u003c/pre\u003e\n\u003c/div\u003e\n\u003cp\u003e上面头信息中，\u003ccode\u003eAccess-Control-Allow-Origin\u003c/code\u003e字段是每次回应都必定包含的。\u003c/p\u003e\n\u003ch2 id=\"参考\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e5%8f%82%e8%80%83\" class=\"header-mark\"\u003e\u003c/a\u003e4 参考\u003c/h2\u003e\u003cul\u003e\n\u003cli\u003e\u003ca href=\"https://blog.csdn.net/qq_42625428/article/details/108099755\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e跨域及其解决方案\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"https://developer.mozilla.org/en-US/docs/web/http/cors#simple_requests\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://developer.mozilla.org/en-US/docs/web/http/cors#simple_requests\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"http://www.ruanyifeng.com/blog/2016/04/cors.html\" target=\"_blank\" rel=\"noopener noreferrer\"\u003e跨域资源共享 CORS 详解\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n",
        "language": "zh-cn"
    },
    {
        "title" : "wampserver 的安装和使用",
        "date_published" : "2018-11-12T00:00:00Z",
        "date_modified" : "2025-02-19T18:55:07+08:00",
        "id" : "https://www.xiaobinqt.cn/wampserver-install-usage/",
        "url" : "https://www.xiaobinqt.cn/wampserver-install-usage/",
        "summary": " 本地开发 php 环境推荐使用 wampserver，下载地址为 WampServer download | SourceForge.net\n当然国产的 phpStudy 也可以，个人喜好问题。\n",
        "author" : {
          "name" : "xiaobinqt"
        },
        "content_html" : "\u003c!-- author： xiaobinqt --\u003e\n\u003c!-- email： xiaobinqt@163.com --\u003e\n\u003c!-- https://xiaobinqt.github.io --\u003e\n\u003c!-- https://www.xiaobinqt.cn --\u003e\n\u003cp\u003e本地开发 php 环境推荐使用 wampserver，下载地址为 \u003ca href=\"https://sourceforge.net/projects/wampserver/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eWampServer download | SourceForge.net\u003c/a\u003e\u003c/p\u003e\n\u003cp\u003e当然国产的 phpStudy 也可以，个人喜好问题。\u003c/p\u003e\n\u003ch2 id=\"下载\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e4%b8%8b%e8%bd%bd\" class=\"header-mark\"\u003e\u003c/a\u003e1 下载\u003c/h2\u003e\u003cblockquote\u003e\n  \u003cp\u003e如果缺少 Visual C++ 的扩展，可以去 \u003ca href=\"https://wampserver.aviatechno.net/\" target=\"_blank\" rel=\"noopener noreferrer\"\u003ehttps://wampserver.aviatechno.net/\u003c/a\u003e 统一下载。\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003cp\u003e安装 wampserver 之前我们需要先安装 Visual C++ Redistributable for Visual Studio，这是 visual 2015\n的下载地址 \u003ca href=\"https://www.microsoft.com/en-us/download/details.aspx?id=48145\" target=\"_blank\" rel=\"noopener noreferrer\"\u003eVisual C++ Redistributable for Visual Studio 2015 from Official Microsoft Download Center\u003c/a\u003e\n，根据自己的版本下载对应的版本。\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/1e2f0f30d30b4f918136fc3b6ea9583d_9812918952690527910.png\" title=\"Visual Studio\" data-thumbnail=\"/1e2f0f30d30b4f918136fc3b6ea9583d_9812918952690527910.png\" data-sub-html=\"\u003ch2\u003eVisual Studio\u003c/h2\u003e\u003cp\u003eVisual Studio\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/1e2f0f30d30b4f918136fc3b6ea9583d_9812918952690527910.png srcset=\"/1e2f0f30d30b4f918136fc3b6ea9583d_9812918952690527910_hu3227916323078614381.webp 800w, /1e2f0f30d30b4f918136fc3b6ea9583d_9812918952690527910_hu6995170349292596418.webp 1200w, /1e2f0f30d30b4f918136fc3b6ea9583d_9812918952690527910_hu7942023420328191026.webp 1600w\"  alt=\"Visual Studio\" height=\"376\" width=\"544\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eVisual Studio\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003evisual c++ redistributable for visual studio 2012 在很多时候已经不能用了。\u003c/p\u003e\n\u003cp\u003e我安装的是 64 位的 wampserver，所以下载对应的 visual C++：\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/cd4d8a8ff6214663b4ba2b70df7957e2_4967043726490319899.png\" title=\"visual C\u0026#43;\u0026#43; 图 1\" data-thumbnail=\"/cd4d8a8ff6214663b4ba2b70df7957e2_4967043726490319899.png\" data-sub-html=\"\u003ch2\u003evisual C\u0026#43;\u0026#43; 图 1\u003c/h2\u003e\u003cp\u003evisual C\u0026#43;\u0026#43; 图 1\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/cd4d8a8ff6214663b4ba2b70df7957e2_4967043726490319899.png srcset=\"/cd4d8a8ff6214663b4ba2b70df7957e2_4967043726490319899_hu9588080665015581111.webp 800w, /cd4d8a8ff6214663b4ba2b70df7957e2_4967043726490319899_hu3843940729619578755.webp 1200w, /cd4d8a8ff6214663b4ba2b70df7957e2_4967043726490319899_hu11091851279015185660.webp 1600w\"  alt=\"visual C\u0026#43;\u0026#43; 图 1\" height=\"503\" width=\"1405\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003evisual C++ 图 1\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/05a4f7bfbb0e40be9e94573cb93ccc1e_16350474712127524077.png\" title=\"visual C\u0026#43;\u0026#43; 图 2\" data-thumbnail=\"/05a4f7bfbb0e40be9e94573cb93ccc1e_16350474712127524077.png\" data-sub-html=\"\u003ch2\u003evisual C\u0026#43;\u0026#43; 图 2\u003c/h2\u003e\u003cp\u003evisual C\u0026#43;\u0026#43; 图 2\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/05a4f7bfbb0e40be9e94573cb93ccc1e_16350474712127524077.png srcset=\"/05a4f7bfbb0e40be9e94573cb93ccc1e_16350474712127524077_hu2385031872588872696.webp 800w, /05a4f7bfbb0e40be9e94573cb93ccc1e_16350474712127524077_hu15602263108293819409.webp 1200w, /05a4f7bfbb0e40be9e94573cb93ccc1e_16350474712127524077_hu9609818314170515381.webp 1600w\"  alt=\"visual C\u0026#43;\u0026#43; 图 2\" height=\"421\" width=\"664\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003evisual C++ 图 2\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e之后安装 wampserver\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/bf7b661cfa4e47179bc03c3649d3e423_3143712155458188476.png\" title=\"安装 wampserver\" data-thumbnail=\"/bf7b661cfa4e47179bc03c3649d3e423_3143712155458188476.png\" data-sub-html=\"\u003ch2\u003e安装 wampserver\u003c/h2\u003e\u003cp\u003e安装 wampserver\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/bf7b661cfa4e47179bc03c3649d3e423_3143712155458188476.png srcset=\"/bf7b661cfa4e47179bc03c3649d3e423_3143712155458188476_hu2385031872588872696.webp 800w, /bf7b661cfa4e47179bc03c3649d3e423_3143712155458188476_hu15602263108293819409.webp 1200w, /bf7b661cfa4e47179bc03c3649d3e423_3143712155458188476_hu9609818314170515381.webp 1600w\"  alt=\"安装 wampserver\" height=\"421\" width=\"664\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003e安装 wampserver\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e在安装过程中会让你选择默认的浏览器和编辑器。\u003c/p\u003e\n\u003ch2 id=\"配置\" class=\"headerLink\"\u003e\n    \u003ca href=\"#%e9%85%8d%e7%bd%ae\" class=\"header-mark\"\u003e\u003c/a\u003e2 配置\u003c/h2\u003e\u003cp\u003e如果有需要可以修改 wampserver 的根目录\u003c/p\u003e\n\u003col\u003e\n\u003cli\u003e打开 wampserver 的安装目录，在打开里面的 script 文件夹，用记事本打开里面的 \u003ccode\u003econfig.inc.php\u003c/code\u003e\n,找到 \u003ccode\u003e$wwwDir = $c_installDir.'/www'\u003c/code\u003e 改成希望的目录就行了。\n比如改成 \u003ccode\u003eD:\\website\u003c/code\u003e，对应的代码就是 \u003ccode\u003e$wwwDir = 'D:/website'\u003c/code\u003e；然后关闭 wampserver。\u003c/li\u003e\n\u003c/ol\u003e\n\u003cblockquote\u003e\n  \u003cp\u003e（注意，windows下表示路径的 \u003ccode\u003e\\\u003c/code\u003e在这里必须改为 \u003ccode\u003e/\u003c/code\u003e）\u003c/p\u003e\n\n\u003c/blockquote\u003e\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/f8dba744064643a7946d8c3e92366c24_3149535231395866922.png\" title=\"wwwDir\" data-thumbnail=\"/f8dba744064643a7946d8c3e92366c24_3149535231395866922.png\" data-sub-html=\"\u003ch2\u003ewwwDir\u003c/h2\u003e\u003cp\u003ewwwDir\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/f8dba744064643a7946d8c3e92366c24_3149535231395866922.png srcset=\"/f8dba744064643a7946d8c3e92366c24_3149535231395866922_hu8899985165957872151.webp 800w, /f8dba744064643a7946d8c3e92366c24_3149535231395866922_hu12275282388195210691.webp 1200w, /f8dba744064643a7946d8c3e92366c24_3149535231395866922_hu17086663393058445457.webp 1600w\"  alt=\"wwwDir\" height=\"148\" width=\"672\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003ewwwDir\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003col start=\"2\"\u003e\n\u003cli\u003e打开 Apach 下面的 \u003ccode\u003ehttpd.conf\u003c/code\u003e 文件，路径示例\u003c/li\u003e\n\u003c/ol\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/a45e7c965a8348ec9f355eeeceea918a_10479572852685486641.png\" title=\"httpd.conf\" data-thumbnail=\"/a45e7c965a8348ec9f355eeeceea918a_10479572852685486641.png\" data-sub-html=\"\u003ch2\u003ehttpd.conf\u003c/h2\u003e\u003cp\u003ehttpd.conf\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/a45e7c965a8348ec9f355eeeceea918a_10479572852685486641.png srcset=\"/a45e7c965a8348ec9f355eeeceea918a_10479572852685486641_hu13270693145593471279.webp 800w, /a45e7c965a8348ec9f355eeeceea918a_10479572852685486641_hu1772867103667478225.webp 1200w, /a45e7c965a8348ec9f355eeeceea918a_10479572852685486641_hu12864314182898305576.webp 1600w\"  alt=\"httpd.conf\" height=\"228\" width=\"835\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003ehttpd.conf\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e寻找 DocumentRoot，把后面的值改成我们实际网站需要的路径，再寻找 \u003ccode\u003e\u0026lt;Directory \u0026quot;c:/wamp/www/\u0026quot;\u0026gt;\u003c/code\u003e 修改成相同的路径\u003c/p\u003e\n\u003cp\u003e\u003cfigure\u003e\u003ca class=\"lightgallery\" href=\"/fc931693d16e4dce98d1ae6babdd4937_1648773466749904651.png\" title=\"DocumentRoot\" data-thumbnail=\"/fc931693d16e4dce98d1ae6babdd4937_1648773466749904651.png\" data-sub-html=\"\u003ch2\u003eDocumentRoot\u003c/h2\u003e\u003cp\u003eDocumentRoot\u003c/p\u003e\"\u003e\u003cimg  loading=\"lazy\" src=/fc931693d16e4dce98d1ae6babdd4937_1648773466749904651.png srcset=\"/fc931693d16e4dce98d1ae6babdd4937_1648773466749904651_hu206034868295651047.webp 800w, /fc931693d16e4dce98d1ae6babdd4937_1648773466749904651_hu6122873320447094635.webp 1200w, /fc931693d16e4dce98d1ae6babdd4937_1648773466749904651_hu6137173414222329545.webp 1600w\"  alt=\"DocumentRoot\" height=\"127\" width=\"647\"\u003e\u003c/a\u003e\u003cfigcaption class=\"image-caption\"\u003eDocumentRoot\u003c/figcaption\u003e\n\u003c/figure\u003e\u003c/p\u003e\n\u003cp\u003e配置虚拟主机 VirtualHost 示例\u003c/p\u003e\n\u003cdiv class=\"code-block highlight is-open show-line-numbers  tw-group tw-my-2\"\u003e\n  \u003cdiv class=\"\n    code-block-title \n    \n    tw-flex \n    tw-flex-row \n    tw-justify-between \n    tw-w-full tw-bg-bgColor-secondary\n    \"\u003e      \n    \u003cbutton \n      class=\"\n        tw-select-none \n        tw-mx-2 \n        tw-block\n        group-[.is-open]:tw-rotate-90\n        tw-transition-[transform] \n        tw-duration-500 \n        tw-ease-in-out\n        print:!tw-hidden\"\n      disabled\n      aria-hidden=\"true\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z\"/\u003e\u003c/svg\u003e\u003c/button\u003e\n\n    \u003cdiv class=\"code-block-title-bar tw-w-full\"\u003e\n      \u003cp class=\"tw-select-none !tw-my-1\"\u003eshell\u003c/p\u003e\n    \u003c/div\u003e\n    \u003cdiv class=\"tw-flex\"\u003e\n      \u003cbutton \n        class=\"\n          line-number-button\n          tw-select-none \n          tw-mx-2 \n          tw-hidden \n          group-[.is-open]:tw-block \n          group-[.show-line-numbers]:tw-text-fgColor-link \n          print:!tw-hidden\" \n        title=\"Toggle line numbers\"\u003e\u003csvg class=\"icon\"\n    xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 512 512\"\u003e\u003c!-- Font Awesome Free 5.15.4 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0, Fonts: SIL OFL 1.1, Code: MIT License) --\u003e\u003cpath d=\"M61.77 401l17.5-20.15a19.92 19.92 0 0 0 5.07-14.19v-3.31C84.34 356 80.5 352 73 352H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8h22.83a157.41 157.41 0 0 0-11 12.31l-5.61 7c-4 5.07-5.25 10.13-2.8 14.88l1.05 1.93c3 5.76 6.29 7.88 12.25 7.88h4.73c10.33 0 15.94 2.44 15.94 9.09 0 4.72-4.2 8.22-14.36 8.22a41.54 41.54 0 0 1-15.47-3.12c-6.49-3.88-11.74-3.5-15.6 3.12l-5.59 9.31c-3.72 6.13-3.19 11.72 2.63 15.94 7.71 4.69 20.38 9.44 37 9.44 34.16 0 48.5-22.75 48.5-44.12-.03-14.38-9.12-29.76-28.73-34.88zM496 224H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zm0-160H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16V80a16 16 0 0 0-16-16zm0 320H176a16 16 0 0 0-16 16v32a16 16 0 0 0 16 16h320a16 16 0 0 0 16-16v-32a16 16 0 0 0-16-16zM16 160h64a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H64V40a8 8 0 0 0-8-8H32a8 8 0 0 0-7.14 4.42l-8 16A8 8 0 0 0 24 64h8v64H16a8 8 0 0 0-8 8v16a8 8 0 0 0 8 8zm-3.91 160H80a8 8 0 0 0 8-8v-16a8 8 0 0 0-8-8H41.32c3.29-10.29 48.34-18.68 48.34-56.44 0-29.06-25-39.56-44.47-39.56-2